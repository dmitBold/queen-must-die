  m_Script: {fileID: 11500000, guid: 6a35213657138da4bbb063f48d565b05, type: 3}
  m_Name: Dead Guard_ Note
  m_EditorClassIdentifier: Assembly-CSharp::Inventory.DayNoteData
  NotePages:
  - "<u>\"\u0412\u0442\u043E\u0440\u043E\u0439 \u0438 \u043F\u044F\u0442\u044B\u0439
    \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u044E\u0442 \u0434\u0440\u0443\u0433
    \u0437\u0430 \u0434\u0440\u0443\u0433\u043E\u043C. \u042F \u0432\u0441\u0435\u0433\u0434\u0430
    \u0441\u043C\u043E\u0442\u0440\u044E \u0432\u043F\u0435\u0440\u0451\u0434, \u0430
    \u0442\u043E\u0442, \u0447\u0442\u043E \u043D\u0430\u0432\u0435\u043A\u0438 \u0441\u043B\u0435\u0432\u0430
    \u043E\u0442 \u043C\u0435\u043D\u044F, \u043E\u0442\u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
    \u043E\u0442 \u043C\u0438\u0440\u0430.\" </u>."
  - "\u042D\u0442\u043E \u0441\u043B\u043E\u0432\u0430 \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440\u0430,
    \u0438 \u043E\u043D\u0438 \u043A\u0430\u043A-\u0442\u043E \u0441\u0432\u044F\u0437\u0430\u043D\u044B
    \u0441 \u0442\u0435\u043C, \u043A\u0430\u043A \u043F\u043E\u043F\u0430\u0441\u0442\u044C
    \u0432 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u044E. "
  - "\u041D\u0435\u043B\u044C\u0437\u044F \u0434\u0430\u0442\u044C \u0434\u0435\u0432\u043E\u0447\u043A\u0435
    \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u0442\u0443\u0434\u0430.
    \u041D\u0430\u0439\u0434\u0438 \u0447\u0442\u043E \u0437\u043D\u0430\u0447\u0430\u0442
    \u0441\u043B\u043E\u0432\u0430 \u0435\u0451 \u043E\u0442\u0446\u0430, \u0441\u043E\u043B\u0434\u0430\u0442.
    \u041E\u0442 \u0442\u0435\u0431\u044F \u0437\u0430\u0432\u0438\u0441\u0438\u0442
    \u0441\u0443\u0434\u044C\u0431\u0430 \u043D\u0430\u0441\u043B\u0435\u0434\u0438\u044F
    \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440\u0430 \u0412\u0435\u043B\u0438\u043A\u043E\u0433\u043E!"
  NoteName: "\u041E\u0442 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0430"
  icon: {fileID: 21300000, guid: a99d56a46c4079a4989e7058665975ee, type: 3}
