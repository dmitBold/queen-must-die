--- !u!114 &1250307957
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1250307953}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 17593cab2020f8c43a7063ec459d6989, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NoteInteractable
  noteImage: {fileID: 21300000, guid: a99d56a46c4079a4989e7058665975ee, type: 3}
  noteText:
  - "\u0414\u043E\u0440\u043E\u0433\u043E\u0439 \u0431\u0440\u0430\u0442, \u043D\u0430\u0434\u0435\u044E\u0441\u044C,
    \u044F \u0441\u043C\u043E\u0433\u0443 \u0441\u043A\u0430\u0437\u0430\u0442\u044C
    \u0442\u0435\u0431\u0435 \u0432\u0441\u0451 \u044D\u0442\u043E \u0441\u043B\u043E\u0432\u0430\u043C\u0438,
    \u043D\u043E \u0432 \u0436\u0438\u0437\u043D\u0438 \u0431\u044B\u0432\u0430\u0435\u0442
    \u0432\u0441\u044F\u043A\u043E\u0435."
  - "\u042F \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u043D\u0430\u0434 \u0442\u043E\u0431\u043E\u0439
    \u0441\u043C\u0435\u044E\u0442\u0441\u044F. \u0422\u044B \u043D\u0435 \u0431\u044B\u043B
    \u043D\u0430 \u0432\u043E\u0439\u043D\u0435, \u043D\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u043B
    \u044D\u0442\u043E \u043C\u0435\u0441\u0442\u043E \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
    \u043E\u0442\u0446\u0443."
  - "\u0412\u043E\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440
    \u043C\u0435\u0440\u0442\u0432. \u0422\u044B \u043D\u0435 \u043F\u043E\u0441\u043B\u0443\u0436\u0438\u043B
    \u0435\u043C\u0443, \u043D\u043E \u043C\u043E\u0436\u0435\u0448\u044C \u0435\u0449\u0451
    \u043F\u043E\u0441\u043B\u0443\u0436\u0438\u0442\u044C \u0435\u0433\u043E \u0434\u043E\u0447\u0435\u0440\u0438.
    \u0422\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u043F\u043E\u0441\u043B\u0443\u0436\u0438\u0442\u044C
    \u0441\u0432\u043E\u0435\u0439 \u0441\u0435\u043C\u044C\u0435. "
  - "\u041D\u0435 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0439 \u043C\u0435\u043D\u044F..."
  trigger_once: 1
  noteEvent:
    m_PersistentCalls:
      m_Calls: []
  interact_sound:
    Guid:
      Data1: -1225164423
      Data2: 1084857888
      Data3: -266600318
      Data4: -1490920368
    Path: event:/Scenes/Envelope
  trigger_sound_once: 0
  noteData: {fileID: 0}
  journalHintText: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 N, \u0447\u0442\u043E\u0431\u044B
    \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0436\u0443\u0440\u043D\u0430\u043B
    \u0437\u0430\u043F\u0438\u0441\u043E\u043A"
  journalHintDuration: 4
  journalHintFade: 0.5
