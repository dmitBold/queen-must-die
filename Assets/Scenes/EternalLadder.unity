--- !u!114 &682360106
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 682360104}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 38ee0dafac975764fa01df6ab9383f1c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NightCycle.StartDialogue
  dialoguePages:
  - "\u0422\u044B \u0437\u0430\u043F\u0435\u0440\u0442\u0430 \u0432 \u044D\u0442\u043E\u043C
    \u0437\u0430\u043C\u043A\u0435 \u0442\u0430\u043A \u0436\u0435, \u043A\u0430\u043A
    \u0431\u044B\u043B \u0437\u0430\u043F\u0435\u0440\u0442 \u044F. \u0418 \u044D\u0442\u043E
    \u043D\u0435 \u044D\u0444\u0444\u0435\u043A\u0442 \u043D\u043E\u0447\u0438 \u0442\u0430\u0439\u043D.
    \u041A\u0442\u043E-\u0442\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442...
    \u043C\u0430\u0433\u0438\u044E."
  - "\u0422\u044B \u0432\u0440\u0435\u0448\u044C. \u042F \u0447\u0438\u0442\u0430\u043B\u0430,
    \u0447\u0442\u043E \u044D\u0442\u043E \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E
    \u0443\u0436\u0435 \u043C\u043D\u043E\u0433\u043E \u0441\u0442\u043E\u043B\u0435\u0442\u0438\u0439."
  - "\u041E\u0447\u0435\u0432\u0438\u0434\u043D\u043E, \u043A\u0442\u043E-\u0442\u043E
    \u0438\u0437 \u043D\u0430\u0448\u0438\u0445 \u043F\u043E\u0434\u0447\u0438\u043D\u0435\u043D\u043D\u044B\u0445
    \u043D\u0430\u0448\u0435\u043B \u0441\u043F\u043E\u0441\u043E\u0431."
  - "\u042F \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E, \u0447\u0442\u043E
    \u0431\u043B\u0438\u0437\u0438\u0442\u0441\u044F \u0441\u0430\u043C\u0430\u044F
    \u043E\u043F\u0430\u0441\u043D\u0430\u044F \u041D\u043E\u0447\u044C \u0442\u0430\u0439\u043D
    \u0437\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u0432\u0435\u043A\u0430.
    \u0422\u0432\u043E\u0438 \u0432\u0440\u0430\u0433\u0438 \u044F\u0432\u043D\u043E
    \u0443\u043C\u0435\u044E\u0442 \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F
    \u0435\u0451 \u0441\u0438\u043B\u043E\u0439, \u0430 \u044F \u0434\u0430\u0436\u0435
    \u0432 \u044D\u0442\u043E\u043C \u043E\u0431\u043B\u0438\u043A\u0435 \u2014 \u043D\u0435\u0442. "
  - "\u0421 \u043A\u0430\u0436\u0434\u044B\u043C \u043D\u043E\u0432\u044B\u043C \u043D\u0430\u043F\u0430\u0434\u0435\u043D\u0438\u0435\u043C
    \u0438\u0445 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438
    \u0431\u0443\u0434\u0443\u0442 \u0440\u0430\u0441\u0442\u0438. \u0415\u0441\u043B\u0438
    \u0442\u044B \u043D\u0435 \u0443\u0441\u043F\u0435\u0435\u0448\u044C \u043D\u0430\u0439\u0442\u0438
    \u0443\u0433\u0440\u043E\u0437\u0443, \u0442\u043E \u043D\u0438\u0447\u0435\u0433\u043E
    \u0442\u0435\u0431\u044F \u043D\u0435 \u0441\u043F\u0430\u0441\u0435\u0442. "
  - "\u0418\u0434\u0438 \u0438 \u043F\u0440\u0430\u0432\u044C. \u0418\u0449\u0438
    \u0441\u0432\u043E\u0438\u0445 \u0432\u0440\u0430\u0433\u043E\u0432 \u0438 \u0443\u0431\u0435\u0439
    \u0438\u0445 \u0440\u0430\u043D\u044C\u0448\u0435, \u0447\u0435\u043C \u043E\u043D\u0438
    \u0443\u0431\u044C\u044E\u0442 \u0442\u0435\u0431\u044F, \u043F\u043E\u0442\u043E\u043C\u0443
    \u0447\u0442\u043E \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u0432\u044B\u0431\u043E\u0440\u0430
    \u0443 \u0442\u0435\u0431\u044F \u043D\u0435\u0442."
  - "\u042F \u043D\u0435\u043D\u0430\u0432\u0438\u0436\u0443 \u0442\u0435\u0431\u044F."
  - "\u0417\u043D\u0430\u0447\u0438\u0442, \u043F\u0443\u0441\u0442\u044C \u044F\u0440\u043E\u0441\u0442\u044C
    \u043F\u0438\u0442\u0430\u0435\u0442 \u0442\u0435\u0431\u044F."
  dialogueNames:
  - "\u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u0410\u0440\u0433\u0435\u0430\u0434"
  - "\u0411\u0435\u0442 \u0410\u0440\u0433\u0435\u0430\u0434"
  - "\u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u0410\u0440\u0433\u0435\u0430\u0434"
  - "\u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u0410\u0440\u0433\u0435\u0430\u0434"
  - "\u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u0410\u0440\u0433\u0435\u0430\u0434"
  - "\u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u0410\u0440\u0433\u0435\u0430\u0434"
  - "\u0411\u0435\u0442 \u0410\u0440\u0433\u0435\u0430\u0434"
  - "\u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u0410\u0440\u0433\u0435\u0430\u0434"
  delay: 0
  onDialogueCompleted:
    m_PersistentCalls:
      m_Calls: []
  triggerEventOnlyOnce: 1
