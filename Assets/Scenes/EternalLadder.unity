--- !u!114 &196626082
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 196626080}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 38ee0dafac975764fa01df6ab9383f1c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NightCycle.StartDialogue
  dialoguePages:
  - "\u0417\u0430\u0447\u0435\u043C \u0442\u044B \u044D\u0442\u043E \u0434\u0435\u043B\u0430\u0435\u0448\u044C?!
    \u0422\u044B \u043C\u043E\u0433 \u0437\u0430\u0449\u0438\u0442\u0438\u0442\u044C
    \u0438\u0445!"
  - "\u042F \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u043B \u0432\u0441\u0435 \u0441\u0438\u043B\u044B,
    \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0449\u0438\u0449\u0430\u0442\u044C
    \u0442\u0435\u0431\u044F. \u0410 \u043E\u043D\u0438 \u043F\u043E\u043A\u043B\u044F\u043B\u0438\u0441\u044C
    \u0443\u043C\u0435\u0440\u0435\u0442\u044C \u0437\u0430 \u0410\u0440\u0433\u0435\u0430\u0434\u043E\u0432."
  - "\u042F \u043D\u0435 \u0410\u0440\u0433\u0435\u0430\u0434. \u042F \u043D\u0438\u043A\u043E\u0433\u0434\u0430
    \u043D\u0435 \u0445\u043E\u0442\u0435\u043B\u0430 \u043D\u043E\u0441\u0438\u0442\u044C
    \u044D\u0442\u043E \u0438\u043C\u044F! "
  - "\u0412 \u0442\u0435\u0431\u0435 \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u0430\u044F
    \u043A\u0440\u043E\u0432\u044C. \u042D\u0442\u0430 \u0441\u0442\u0440\u0430\u043D\u0430
    \u2014 \u0442\u0432\u043E\u044F \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C. "
  - "\u042F \u0437\u043D\u0430\u044E, \u043A\u0442\u043E \u0442\u044B. \u0414\u0430\u0436\u0435
    \u0432 \u044D\u0442\u043E\u0439 \u0444\u043E\u0440\u043C\u0435 \u044F \u0442\u0435\u0431\u044F
    \u0443\u0437\u043D\u0430\u044E..."
  - "\u041E\u0442\u0435\u0446."
  - "\u0422\u044B \u043C\u0435\u043D\u044F \u0432\u0442\u044F\u043D\u0443\u043B \u0432\u043E
    \u0432\u0441\u0451 \u044D\u0442\u043E, \u043D\u043E \u044F \u043D\u0435 \u0431\u0443\u0434\u0443
    \u043F\u043E\u0442\u0430\u043A\u0430\u0442\u044C \u0442\u0435\u0431\u0435. \u042F
    \u0441\u0430\u043C\u0430 \u0432\u044B\u0431\u0435\u0440\u0443, \u043A\u0435\u043C
    \u0441\u0442\u0430\u043D\u0443. \u042F \u0441\u0431\u0435\u0433\u0443 \u043E\u0442\u0441\u044E\u0434\u0430
    \u0438 \u043E\u0441\u0432\u043E\u0431\u043E\u0436\u0443\u0441\u044C."
  - "\u041D\u0443 \u0442\u0430\u043A \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439"
  dialogueNames:
  - "\u0411\u0435\u0442 \u0410\u0440\u0433\u0435\u0430\u0434"
  - "\u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u0410\u0440\u0433\u0435\u0430\u0434"
  - "\u0411\u0435\u0442 \u0410\u0440\u0433\u0435\u0430\u0434"
  - "\u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u0410\u0440\u0433\u0435\u0430\u0434"
  - "\u0411\u0435\u0442 \u0410\u0440\u0433\u0435\u0430\u0434"
  - "\u0411\u0435\u0442 \u0410\u0440\u0433\u0435\u0430\u0434"
  - "\u0411\u0435\u0442 \u0410\u0440\u0433\u0435\u0430\u0434"
  - "\u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u0410\u0440\u0433\u0435\u0430\u0434"
  delay: 0
  onDialogueCompleted:
    m_PersistentCalls:
      m_Calls: []
  triggerEventOnlyOnce: 1
