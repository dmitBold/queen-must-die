--- !u!114 &966029894
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 966029886}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 38ee0dafac975764fa01df6ab9383f1c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NightCycle.StartDialogue
  dialoguePages:
  - "\u0417\u0434\u0435\u0441\u044C \u043A\u0442\u043E-\u0442\u043E \u0435\u0441\u0442\u044C...
    \u042D\u0442\u043E \u0432\u044B! \u0412\u044B \u0443\u0436\u0435 \u0441\u0442\u0430\u043B\u0438
    \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u043E\u0439?"
  - "\u041A\u0430\u043A \u0432\u044B \u0441\u044E\u0434\u0430 \u043F\u043E\u043F\u0430\u043B\u0438?"
  - "\u041C\u044B \u043F\u0440\u043E\u0448\u043B\u0438 \u0437\u0430 \u043A\u043E\u0440\u043E\u043B\u0435\u043C,
    \u0430 \u043E\u043D \u043D\u0430\u0441 \u0437\u0430\u043C\u0435\u0442\u0438\u043B.
    \u041E\u0441\u0442\u0430\u0432\u0438\u043B \u043D\u0430\u0441 \u0433\u043D\u0438\u0442\u044C
    \u0437\u0434\u0435\u0441\u044C."
  - "\u0422\u043E\u043B\u044C\u043A\u043E \u0442\u043E, \u0447\u0442\u043E \u0432
    \u0432\u0430\u0448\u0435\u0439 \u043A\u043E\u0440\u043E\u043D\u0435, \u0434\u0430\u0451\u0442
    \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
    \u0437\u0434\u0435\u0441\u044C. \u0414\u043B\u044F \u0435\u0451 \u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044F
    \u044D\u0442\u043E \u043C\u0435\u0441\u0442\u043E \u0441\u043E\u0432\u0441\u0435\u043C
    \u0434\u0440\u0443\u0433\u043E\u0435."
  - "\u041D\u0435 \u0437\u043D\u0430\u044E \u0447\u0442\u043E \u0432\u044B \u0434\u0435\u043B\u0430\u0435\u0442\u0435
    \u0437\u0434\u0435\u0441\u044C, \u043D\u043E \u0442\u0443\u0442 \u043D\u0435
    \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E."
  - "\u0414\u0430, \u0441\u0442\u0430\u0442\u0443\u0438 \u0433\u0432\u0430\u0440\u0434\u0435\u0439\u0446\u0435\u0432
    \u0447\u0442\u043E-\u0442\u043E \u043E\u0436\u0438\u0432\u0438\u043B\u043E."
  - "\u0417\u0434\u0435\u0441\u044C \u0435\u0441\u0442\u044C \u043D\u0435\u0447\u0442\u043E
    \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u0441\u0442\u0440\u0430\u0448\u043D\u0435\u0435
    \u0441\u0442\u0430\u0442\u0443\u0439... \u041D\u0435 \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435\u0441\u044C."
  dialogueNames:
  - "\u0421\u0442\u0440\u0430\u0436"
  - "\u0411\u0435\u0442 \u0410\u0440\u0433\u0435\u0430\u0434"
  - "\u0421\u0442\u0440\u0430\u0436"
  - "\u0421\u0442\u0440\u0430\u0436"
  - "\u0421\u0442\u0440\u0430\u0436"
  - "\u0411\u0435\u0442 \u0410\u0440\u0433\u0435\u0430\u0434"
  - "\u0421\u0442\u0440\u0430\u0436"
  delay: 0
  onDialogueCompleted:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 966029891}
