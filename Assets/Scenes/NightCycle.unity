MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 868913223}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 17593cab2020f8c43a7063ec459d6989, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NoteInteractable
  noteImage: {fileID: 21300000, guid: a99d56a46c4079a4989e7058665975ee, type: 3}
  noteText:
  - "\u0420\u043E\u0434 \u0421\u0435\u043B\u0435\u0432\u043A\u0438\u0434\u043E\u0432\n\n\u0421\u0438\u043B\u0430:
    \u041A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u0443\u044E\u0442 \u0431\u043E\u043B\u044C\u0448\u0443\u044E
    \u0447\u0430\u0441\u0442\u044C \u0434\u043E\u0431\u044B\u0447\u0438 \u0441\u043E\u043B\u0438.\n\n\u0420\u0435\u0448\u0435\u043D\u0438\u0435:
    \u041F\u043E\u0434\u0433\u0430\u0434\u0430\u0442\u044C \u043C\u043E\u043C\u0435\u043D\u0442,
    \u0447\u0442\u043E\u0431\u044B \u0440\u0430\u0437\u043D\u0435\u0441\u0442\u0438
    \u0441\u043B\u0443\u0445 \u0441\u0440\u0435\u0434\u0438 \u043D\u0430\u0440\u043E\u0434\u0430
    \u043E \u0437\u0430\u0432\u044B\u0448\u0435\u043D\u0438\u0438 \u0446\u0435\u043D
    \u043D\u0430 \u0441\u043E\u043B\u044C. \u041D\u0435 \u0432\u044B\u0439\u0442\u0438
    \u043D\u0430 \u0437\u0430\u0449\u0438\u0442\u044B \u041F\u0442\u043E\u043B\u0435\u043C\u0435\u0435\u0432,
    \u043A\u043E\u0433\u0434\u0430 \u0438\u0445 \u0434\u043E\u043C\u0430 \u043F\u0440\u0438\u0434\u0443\u0442
    \u0433\u0440\u043E\u043C\u0438\u0442\u044C."
  - "\u0421\u043B\u0430\u0431\u043E\u0441\u0442\u044C: \u0421\u0435\u043B\u0435\u0432\u043A\u0438\u0434\u044B
    \u043D\u0438 \u043F\u0440\u0438 \u043A\u0430\u043A\u0438\u0445 \u043E\u0431\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430\u0445
    \u043D\u0435 \u0441\u0442\u0430\u043D\u0443\u0442 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0430\u0442\u044C
    \u0441 \u043D\u0435\u043B\u044E\u0434\u044C\u043C\u0438.\n\n\u041F\u0440\u0438\u043C\u0435\u0447\u0430\u043D\u0438\u0435:
    \u0421\u043B\u0435\u0434\u0438\u0442\u044C \u0437\u0430 \u0432\u0437\u0440\u043E\u0441\u043B\u0435\u043D\u0438\u0435\u043C
    \u0414\u0436\u0443\u043B \u0421\u0435\u043B\u0435\u0432\u043A\u0438\u0434."
