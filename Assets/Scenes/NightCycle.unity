--- !u!114 &713170622
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 713170618}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 17593cab2020f8c43a7063ec459d6989, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NoteInteractable
  noteImage: {fileID: 21300000, guid: a99d56a46c4079a4989e7058665975ee, type: 3}
  noteText:
  - "\u0420\u043E\u0434 \u0410\u043C\u0438\u043D\u0442\u043E\u0440\u043E\u0432\n\n\u0421\u0438\u043B\u0430:
    \u0413\u0435\u0444\u0435\u0441\u0442\u0438\u043E\u043D \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B
    \u0441\u0432\u043E\u0438\u0445 \u0440\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u0438\u043A\u043B\u0432
    \u043D\u0430 \u043C\u043D\u043E\u0433\u0438\u0435 \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u0435
    \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u0438 \u0432 \u0430\u0440\u043C\u0438\u0438.
    \u0415\u0441\u043B\u0438 \u043E\u043D\u0438 \u0437\u0430\u0445\u043E\u0442\u044F\u0442
    \u043D\u0430\u0447\u0430\u0442\u044C \u0433\u0440\u0430\u0436\u0434\u0430\u043D\u0441\u043A\u0443\u044E
    \u0432\u043E\u0439\u043D\u0443, \u0442\u043E \u0443 \u043D\u0438\u0445 \u044D\u0442\u043E
    \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F.\n\n\u0420\u0435\u0448\u0435\u043D\u0438\u0435:
    \u042F \u0434\u043E\u0432\u0435\u0440\u044F\u044E \u0413\u0435\u0444\u0435\u0441\u0442\u0438\u043E\u043D\u0443,
    \u043D\u043E \u043F\u043E\u0441\u043B\u0435 \u0435\u0433\u043E \u0441\u043C\u0435\u0440\u0442\u0438
    \u043C\u043D\u0435 \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F \u043E\u0447\u0438\u0441\u0442\u0438\u0442\u044C
    \u0430\u0440\u043C\u0438\u044E \u043E\u0442 \u0435\u0433\u043E \u0441\u0435\u043C\u044C\u0438."
  - "\u0421\u043B\u0430\u0431\u043E\u0441\u0442\u044C: \u041F\u0440\u044F\u043C\u043E\u043B\u0438\u043D\u0435\u0439\u043D\u043E\u0441\u0442\u044C.
    \u0413\u0435\u0444\u0435\u0441\u0442\u0438\u043E\u043D \u0434\u043E\u043B\u0433\u043E
    \u0443\u0447\u0438\u043B \u0441\u0432\u043E\u0438\u0445 \u0434\u0435\u0442\u0435\u0439
    \u0447\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u0438 \u0438 \u0434\u043E\u0431\u043B\u0435\u0441\u0442\u0438.
    \u0418\u0445 \u043B\u0435\u0433\u043A\u043E \u043C\u043E\u0436\u043D\u043E \u0443\u0431\u0435\u0434\u0438\u0442\u044C
    \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0438\u0441\u0442\u0438\u043D\u0443.\n\n\u041F\u0440\u0438\u043C\u0435\u0447\u0430\u043D\u0438\u0435:
    \u041D\u0435 \u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F \u043F\u0435\u0440\u0435\u043F\u0438\u0442\u044C
    \u0410\u043C\u0438\u043D\u0442\u043E\u0440\u0430!"
