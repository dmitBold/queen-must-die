  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NightCycle.NightDialogueInteractable
  dialoguePages:
  - "\u042D\u0442\u043E \u043D\u0435 \u0432\u0441\u044F \u0435\u0433\u043E \u043A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u044F.
    \u0413\u0434\u0435-\u0442\u043E \u0432 \u0437\u0430\u043C\u043A\u0435 \u043E\u043D
    \u0441\u043F\u0440\u044F\u0442\u0430\u043B \u0432\u044B\u0432\u0435\u0437\u0435\u043D\u043D\u044B\u0435
    \u0441 \u0437\u0435\u043C\u0435\u043B\u044C \u043D\u0435\u043B\u044E\u0434\u0435\u0439
    \u0444\u043E\u043B\u0438\u0430\u043D\u0442\u044B."
  - "\u0417\u0430 \u043D\u0438\u0445 \u043E\u043D \u043B\u0435\u0433\u043A\u043E
    \u0433\u043E\u0442\u043E\u0432 \u0431\u044B\u043B \u043F\u0440\u043E\u043B\u0438\u0432\u0430\u0442\u044C
    \u043A\u0440\u043E\u0432\u044C."
  - "\u0412\u043F\u0440\u043E\u0447\u0435\u043C, \u0434\u043B\u044F \u043D\u0435\u0433\u043E
    \u044D\u0442\u043E \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0431\u044B\u043B\u043E
    \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u043E\u0439."
  interact_sound: {fileID: 0}
  dialogue_sounds: []
  dialogue_sounds_index: 0
  onDialogueCompleted:
    m_PersistentCalls:
      m_Calls: []
  triggerEventOnlyOnce: 1
