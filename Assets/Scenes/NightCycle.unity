--- !u!114 &496403561
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 496403559}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 17593cab2020f8c43a7063ec459d6989, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NoteInteractable
  noteImage: {fileID: 21300000, guid: 0345de52d30a6d147bcf358100db9bfa, type: 3}
  noteText: "\u0412\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u044F
    \u043A\u043E\u0440\u043E\u043B\u044F \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440\u0430
    \u041F\u0435\u0440\u0432\u043E\u0433\u043E \u043E \u0432\u043E\u0439\u043D\u0435
    \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F\n\n\u041A\u0430\u0436\u0434\u044B\u0439
    \u0436\u0438\u0442\u0435\u043B\u044C \u043C\u043E\u0435\u0439 \u043D\u043E\u0432\u043E\u0439
    \u0438\u043C\u043F\u0435\u0440\u0438\u0438 \u0437\u043D\u0430\u0435\u0442 \u0432
    \u043A\u0430\u043A\u043E\u043C \u043F\u043E\u0440\u044F\u0434\u043A\u0435 \u043F\u0440\u0435\u0434\u043E
    \u043C\u043D\u043E\u0439 \u043F\u0440\u0435\u043A\u043B\u043E\u043D\u0438\u043B\u0438
    \u043A\u043E\u043B\u0435\u043D\u0438 \u043D\u0435\u043B\u044E\u0434\u0438. \u041F\u0435\u0440\u0432\u044B\u043C\u0438
    \u0441\u0434\u0430\u043B\u0438\u0441\u044C \u043E\u0441\u044B. \u041F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A,
    \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043C\u043E\u0438 \u043F\u0440\u0435\u0434\u043A\u0438
    \u0441\u0447\u0438\u0442\u0430\u043B\u0438 \u043E\u0434\u043D\u0438\u043C \u0438\u0437
    \u0441\u0430\u043C\u044B\u0445 \u043E\u043F\u0430\u0441\u043D\u044B\u0445, \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
    \u043D\u0430 \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435 \u0441\u0430\u043C\u044B\u043C
    \u043F\u0430\u0441\u0441\u0438\u0432\u043D\u044B\u043C \u0432 \u0432\u043E\u0439\u043D\u0435,
    \u0447\u0442\u043E \u0438 \u0441\u0433\u0443\u0431\u0438\u043B\u043E \u0435\u0433\u043E.
    \u0412\u0442\u043E\u0440\u044B\u043C\u0438 \u043F\u0430\u043B\u0438 \u0437\u043C\u0435\u0438.
    \u0414\u0435\u043D\u044C \u0438 \u043D\u043E\u0447\u044C \u043C\u044B \u0437\u0430\u043B\u0438\u0432\u0430\u043B\u0438
    \u0432\u043E\u0434\u043E\u0439, \u0437\u0430\u0434\u044B\u043C\u043B\u044F\u043B\u0438
    \u0438 \u0437\u0430\u0432\u0430\u043B\u0438\u0432\u0430\u043B\u0438 \u0438\u0445
    \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u044F. \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
    \u0441\u0434\u0430\u043B\u0438\u0441\u044C \u043F\u0430\u0443\u043A\u0438. \u041A\u0442\u043E
    \u0431\u044B \u043C\u043E\u0433 \u043F\u043E\u0434\u0443\u043C\u0430\u0442\u044C,
    \u0447\u0442\u043E \u043A\u0430\u043A\u0438\u0435-\u0442\u043E \u0441\u0442\u0438\u0445\u043E\u043F\u043B\u0435\u0442\u044B
    \u0431\u0443\u0434\u0443\u0442 \u0431\u0440\u043E\u0441\u0430\u0442\u044C\u0441\u044F
    \u043D\u0430 \u043D\u0430\u0441, \u043D\u0435 \u0437\u043D\u0430\u044F \u0441\u0442\u0440\u0430\u0445\u0430?"
