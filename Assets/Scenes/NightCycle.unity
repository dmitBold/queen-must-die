    \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440\u0430 I \u0410\u0440\u0433\u0435\u0430\u0434\u0430:
    \u0412\u043E\u0439\u043D\u0430 \u041E\u0431\u044A\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F"
