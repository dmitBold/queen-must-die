--- !u!114 &175142980
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 175142977}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 17593cab2020f8c43a7063ec459d6989, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NightCycle.NoteInteractable
  noteImage: {fileID: 21300000, guid: 0345de52d30a6d147bcf358100db9bfa, type: 3}
  noteText:
  - "\u0422\u0440\u0435\u0442\u0438\u0439 \u0434\u0435\u043D\u044C \u0442\u0440\u0435\u0442\u044C\u0435\u0433\u043E
    \u043C\u0435\u0441\u044F\u0446\u0430 1029 \u0433\u043E\u0434\u0430\r\n\r\n\u0417\u0430\u0447\u0435\u043C
    \u044F \u043A\u043E\u0440\u043E\u043B\u044E? \u0414\u043E\u043F\u0443\u0441\u0442\u0438\u043C,
    \u0447\u0442\u043E \u044F \u043F\u0440\u0430\u0432\u0434\u0430 \u0435\u0433\u043E
    \u0431\u0430\u0441\u0442\u0430\u0440\u0434. \u0414\u043E\u043F\u0443\u0441\u0442\u0438\u043C,
    \u043E\u043D \u0441\u0434\u0435\u043B\u0430\u043B \u043C\u0435\u043D\u044F \u0437\u0430\u043A\u043E\u043D\u043D\u043E\u0439
    \u043D\u0430\u0441\u043B\u0435\u0434\u043D\u0438\u0446\u0435\u0439. \u041D\u043E
    \u043D\u0435\u0443\u0436\u0435\u043B\u0438 \u044F \u0435\u0433\u043E \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u0440\u0435\u0431\u0435\u043D\u043E\u043A? \r\n\r\n\u042F \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u044E.
    \u042F \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u0430 \u0438\u043B\u0438
    \u044F \u0432 \u0443\u0436\u0430\u0441\u0435?"
  - "\u0422\u0440\u0435\u0442\u0438\u0439 \u0434\u0435\u043D\u044C \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u043E\u0433\u043E
    \u043C\u0435\u0441\u044F\u0446\u0430 1026 \u0433\u043E\u0434\u0430\r\n\r\n\u0414\u043E
    \u0441\u0438\u0445 \u043F\u043E\u0440 \u043D\u0435 \u043D\u0430\u0443\u0447\u0438\u043B\u0430\u0441\u044C
    \u043E\u0431\u0449\u0430\u0442\u044C\u0441\u044F \u0441\u043E \u0437\u043D\u0430\u0442\u044C\u044E.
    \u041E\u043D\u0438 \u0442\u0430\u043A\u0438\u0435 \u043D\u0430\u0434\u043C\u0435\u043D\u043D\u044B\u0435.
    \u0422\u0430\u043A\u0438\u0435 \u043B\u0436\u0438\u0432\u044B\u0435.\r\n\r\n\u0421
    \u043E\u0434\u043D\u043E\u0439 \u0434\u0435\u0432\u0443\u0448\u043A\u043E\u0439
    \u044F \u0432\u0441\u0435 \u0436\u0435 \u0441\u043C\u043E\u0433\u043B\u0430 \u043F\u043E\u0434\u0440\u0443\u0436\u0438\u0442\u044C\u0441\u044F
    - \u0414\u0436\u0443\u043B \u0421\u0435\u043B\u0435\u0432\u043A\u0438\u0434.
    \"\u041E\u0442\u0435\u0446\" \u0434\u0443\u043C\u0430\u0435\u0442, \u0447\u0442\u043E
    \u044F \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E \u0441\u0431\u043B\u0438\u0437\u0438\u043B\u0430\u0441\u044C
    \u0441 \u043F\u043E\u043F\u0443\u043B\u044F\u0440\u043D\u043E\u0439 \u043F\u0440\u0438
    \u0434\u0432\u043E\u0440\u0435 \u043F\u0435\u0440\u0441\u043E\u043D\u043E\u0439.
    \u0417\u0434\u0435\u0441\u044C \u0447\u0442\u043E, \u043D\u0435\u043B\u044C\u0437\u044F
    \u043F\u0440\u043E\u0441\u0442\u043E \u0431\u043E\u043B\u0442\u0430\u0442\u044C
    \u0438 \u0432\u0441\u0435?"
