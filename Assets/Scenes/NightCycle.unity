--- !u!114 &500318618
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 500318615}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 17593cab2020f8c43a7063ec459d6989, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NoteInteractable
  noteImage: {fileID: 21300000, guid: a99d56a46c4079a4989e7058665975ee, type: 3}
  noteText: "\u0414\u043E\u0447\u044C \u043C\u043E\u044F, \u0435\u0441\u043B\u0438
    \u0431\u044B \u043D\u0435 \u0442\u0432\u043E\u044F \u043C\u0430\u0442\u044C,
    \u043C\u044B \u043C\u043E\u0433\u043B\u0438 \u0431\u044B \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C\u0441\u044F
    \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u0440\u0430\u043D\u044C\u0448\u0435.
    \u042F \u0431\u044B \u043D\u0430\u0443\u0447\u0438\u043B \u0442\u0435\u0431\u044F
    \u0431\u043E\u043B\u044C\u0448\u0435\u043C\u0443. \u041D\u043E \u0441\u0435\u0439\u0447\u0430\u0441,
    \u043A\u043E\u0433\u0434\u0430 \u044F \u043F\u0438\u0448\u0443 \u044D\u0442\u043E
    \u043F\u043E\u0441\u043B\u0430\u043D\u0438\u0435, \u044F \u0447\u0435\u0442\u043A\u043E
    \u0432\u0438\u0436\u0443, \u0447\u0442\u043E \u0436\u0438\u0442\u044C \u043C\u043D\u0435
    \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043D\u0435 \u0434\u043E\u043B\u0433\u043E.\r\n\r\n\u042D\u0442\u043E\u0442
    \u0437\u0430\u043C\u043E\u043A \u0445\u043E\u0447\u0435\u0442 \u0443\u0431\u0438\u0442\u044C
    \u043C\u0435\u043D\u044F. \u0418 \u044F \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u044E
    \u043F\u0440\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0438\u0445
    \u043F\u0440\u0438\u0445\u043B\u0435\u0431\u0430\u0442\u0435\u043B\u0435\u0439.
    \u042F \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u044E \u043F\u0440\u043E \u043D\u0435\u043B\u044E\u0434\u0435\u0439,
    \u0447\u0442\u043E \u0441\u043A\u0440\u044B\u0432\u0430\u044E\u0442 \u0436\u0430\u0436\u0434\u0443
    \u043A \u043C\u0449\u0435\u043D\u0438\u044E. \u042F \u0433\u043E\u0432\u043E\u0440\u044E
    \u043F\u0440\u043E \u0441\u0430\u043C\u043E \u0437\u0434\u0430\u043D\u0438\u0435.
    \r\n\r\n\u0422\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0448\u044C \u044D\u0442\u043E
    \u043F\u0438\u0441\u044C\u043C\u043E \u043F\u043E\u0441\u043B\u0435 \u043C\u043E\u0435\u0439
    \u0441\u043C\u0435\u0440\u0442\u0438. \u0412\u043E\u0442 \u043C\u043E\u0435 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435
    \u043D\u0430\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u0435 - \u043D\u0435
    \u0442\u0435\u0440\u044F\u0439 \u0431\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C."
