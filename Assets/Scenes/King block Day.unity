  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NightCycle.NightDialogueInteractable
  dialoguePages:
  - "\u0427\u0442\u043E \u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442 \u044D\u0442\u043E
    \u0447\u0443\u0434\u043E\u0432\u0438\u0449\u0435?"
  - "\u041A\u0430\u0431\u0438\u043D\u0435\u0442 \u043A\u043E\u0440\u043E\u043B\u044F,
    \u043C\u043E\u044F \u043F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0430."
  - "\u041C\u043D\u0435 \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C, \u043E\u043D
    \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u0432 \u0441\u043F\u0430\u043B\u044C\u043D\u0435."
  - "\u041E\u043D \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u043F\u043E \u0432\u0441\u0435\u043C\u0443
