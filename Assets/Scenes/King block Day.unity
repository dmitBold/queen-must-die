  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NightCycle.NightDialogueInteractable
  dialoguePages:
  - "\u0414\u043E\u0431\u0440\u044B\u0439 \u0434\u0435\u043D\u044C, \u043F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0430."
  - "\u0422\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u043A\u043E \u043C\u043D\u0435
    \u0442\u0430\u043A \u043D\u0435 \u043E\u0431\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F."
  - "\u041C\u043D\u0435 \u043E\u0442\u0440\u0435\u0436\u0443\u0442 \u044F\u0437\u044B\u043A,
    \u0435\u0441\u043B\u0438 \u044F \u043D\u0435 \u0431\u0443\u0434\u0443 \u0442\u0430\u043A
    \u043E\u0431\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F."
  - "\u0422\u0435\u0431\u0435 \u0432\u0440\u043E\u0434\u0435 \u043D\u0443\u0436\u043D\u0430
    \u0431\u044B\u043B\u0430 \u043F\u043E\u043C\u043E\u0449\u044C \u043E\u0442 \u043F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u044B?"
  - "\u0414\u0430! \u0424\u0438\u043B\u0430\u0434\u0435\u043B\u044C\u0444 \u041F\u0442\u043E\u043B\u0435\u043C\u0435\u0439
    \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0443\u0435\u0442 \u0440\u0430\u0441\u043A\u043E\u043F\u043A\u0438
    \u043F\u043E\u0434 \u0437\u0430\u043C\u043A\u043E\u043C. \u041E\u043D \u0447\u0430\u0441\u0442\u043E
    \u0431\u044B\u0432\u0430\u0435\u0442 \u0443 \u043A\u043E\u0440\u043E\u043B\u044F. "
  - "\u041F\u0440\u043E\u0448\u0443 \u0432\u0430\u0441, \u0437\u0430\u043C\u043E\u043B\u0432\u0438\u0442\u0435
    \u0437\u0430 \u043C\u0435\u043D\u044F \u0441\u043B\u043E\u0432\u0435\u0447\u043A\u043E.
    \u041F\u0443\u0441\u0442\u044C \u043E\u043D \u0432\u043E\u0437\u044C\u043C\u0451\u0442
    \u043C\u0435\u043D\u044F \u0441 \u0441\u043E\u0431\u043E\u0439. "
  - "\u042F \u0432\u0441\u0435\u0433\u0434\u0430 \u043C\u0435\u0447\u0442\u0430\u043B
    \u0441\u0442\u0430\u0442\u044C \u043F\u0435\u0440\u0432\u043E\u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0442\u0435\u043B\u0435\u043C
    \u0447\u0435\u0433\u043E-\u0442\u043E!"
  dialogueNames:
  - "\u0420\u043E\u043C \u041F\u0442\u043E\u043B\u0435\u043C\u0435\u0439"
  - "\u041F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0430 \u0411\u0435\u0442"
  - "\u0420\u043E\u043C \u041F\u0442\u043E\u043B\u0435\u043C\u0435\u0439"
