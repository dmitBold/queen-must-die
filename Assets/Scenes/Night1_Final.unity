  m_Script: {fileID: 11500000, guid: 38ee0dafac975764fa01df6ab9383f1c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NightCycle.StartDialogue
  dialogueName: "\u041A\u043E\u0440\u043E\u043B\u044C \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440"
  dialoguePages:
  - "\u0417\u0430\u0447\u0435\u043C \u0442\u044B \u044D\u0442\u043E \u0434\u0435\u043B\u0430\u0435\u0448\u044C?!
    \u0422\u044B \u043C\u043E\u0433 \u0437\u0430\u0449\u0438\u0442\u0438\u0442\u044C
    \u0438\u0445!"
  - "\u042F \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u043B \u0432\u0441\u0435 \u0441\u0438\u043B\u044B,
    \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0449\u0438\u0449\u0430\u0442\u044C
    \u0442\u0435\u0431\u044F. \u0410 \u043E\u043D\u0438 \u043F\u043E\u043A\u043B\u044F\u043B\u0438\u0441\u044C
    \u0443\u043C\u0435\u0440\u0435\u0442\u044C \u0437\u0430 \u0410\u0440\u0433\u0435\u0430\u0434\u043E\u0432."
  - "\u042F \u043D\u0435 \u0410\u0440\u0433\u0435\u0430\u0434. \u042F \u043D\u0435
    \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0445\u043E\u0442\u0435\u043B\u0430
    \u0431\u044B\u0442\u044C \u0438\u043C! \u0417\u0430\u0447\u0435\u043C \u044F
    \u0442\u0435\u0431\u0435? \u041F\u043E\u0447\u0435\u043C\u0443 \u0442\u044B \u0432\u0442\u044F\u043D\u0443\u043B
    \u0438\u043C\u0435\u043D\u043D\u043E \u043C\u0435\u043D\u044F \u0432 \u044D\u0442\u043E?!"
  - "\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0432 \u0442\u0435\u0431\u0435
    \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u0430\u044F \u043A\u0440\u043E\u0432\u044C.
    \u042D\u0442\u0430 \u0441\u0442\u0440\u0430\u043D\u0430 - \u0442\u0432\u043E\u044F
    \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C. "
  - "\u0421\u043A\u043E\u043B\u044C\u043A\u043E \u0431\u044B \u044F \u0442\u0435\u0431\u044F
    \u043D\u0435 \u0437\u0430\u043A\u0430\u043B\u044F\u043B, \u0442\u044B \u0432\u0441\u0451
    \u0435\u0449\u0435 \u043E\u0441\u0442\u0430\u0435\u0448\u044C\u0441\u044F \u0438\u0437\u0431\u0430\u043B\u043E\u0432\u0430\u043D\u043D\u043E\u0439
    \u0434\u0435\u0432\u043A\u043E\u0439. \u041A\u043E\u0435-\u043A\u043E\u0433\u043E
    \u0442\u044B \u043C\u043D\u0435 \u044D\u0442\u0438\u043C \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0448\u044C. "
  - "\u042F \u0443\u0439\u0434\u0443 \u0438\u0437 \u044D\u0442\u043E\u0433\u043E
    \u0437\u0430\u043C\u043A\u0430. \u042F \u0441\u043A\u0440\u043E\u044E\u0441\u044C
    \u043E\u0442 \u0432\u0441\u0435\u0445!"
  - "\u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439."
  delay: 0
  onDialogueCompleted:
    m_PersistentCalls:
      m_Calls: []
