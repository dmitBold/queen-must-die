  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 38ee0dafac975764fa01df6ab9383f1c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NightCycle.StartDialogue
  dialogueName: "\u041A\u043E\u0440\u043E\u043B\u044C \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440"
  dialoguePages:
  - "\u0422\u044B... \u043F\u0440\u0438\u0437\u0440\u0430\u043A?"
  - "\u042F \u0431\u0435\u0437 \u043F\u043E\u043D\u044F\u0442\u0438\u044F \u0447\u0442\u043E
    \u044F \u0442\u0430\u043A\u043E\u0435. \u041D\u0435\u0447\u0442\u043E \u0440\u0430\u0437\u043E\u0440\u0432\u0430\u043B\u043E
    \u043C\u0435\u043D\u044F \u0438\u0437\u043D\u0443\u0442\u0440\u0438, \u0430 \u0442\u0435\u043F\u0435\u0440\u044C
    \u044F \u0437\u0434\u0435\u0441\u044C. \n"
  - "\u042F \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E \u0441\u0435\u0431\u044F
    \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E \u0438\u043D\u0430\u0447\u0435.
    \u0411\u0443\u0434\u0442\u043E \u0441\u0442\u0435\u043D\u044B \u0437\u0430\u043C\u043A\u0430
    - \u044D\u0442\u043E \u043C\u043E\u044F \u043F\u043B\u043E\u0442\u044C. \u042F
    \u0441\u0432\u044F\u0437\u0430\u043D \u0441 \u043D\u0438\u043C \u0438 \u0435\u0449\u0435
    \u0441 \u0447\u0435\u043C-\u0442\u043E, \u0447\u0442\u043E \u044F \u043F\u043E\u043A\u0430
    \u043D\u0435 \u043D\u0430\u0448\u0435\u043B."
  - "\u0427\u0442\u043E \u0442\u0435\u0431\u044F \u0443\u0431\u0438\u043B\u043E?"
  - "\u042F \u043D\u0435 \u0437\u043D\u0430\u044E. \u041D\u043E \u043E\u043D\u043E
    \u0442\u043E\u0436\u0435 \u043E\u0431\u0438\u0442\u0430\u0435\u0442 \u0432 \u044D\u0442\u043E\u043C
    \u043C\u0438\u0440\u0435 \u0437\u0430 \u0441\u0442\u0435\u043D\u0430\u043C\u0438.
    \u041C\u0435\u043D\u044F \u043D\u0435\u043A\u043E\u043C\u0443 \u0431\u044B\u043B\u043E
    \u0437\u0430\u0449\u0438\u0442\u0438\u0442\u044C, \u0430 \u0442\u0435\u0431\u044F
    \u043F\u043E \u043C\u0435\u0440\u0435 \u0441\u0438\u043B \u0437\u0430\u0449\u0438\u0449\u0430\u044E
    \u044F."
  - "\u0420\u0430\u0437 \u0443\u0436 \u0442\u0430\u043A, \u0442\u043E \u043E\u0442\u0432\u0435\u0434\u0438
    \u043C\u0435\u043D\u044F \u043A \u0441\u0442\u0440\u0430\u0436\u0435."
  - "\u041A\u0430\u043A \u043F\u043E\u0436\u0435\u043B\u0430\u0435\u0442\u0435, \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0430."
  delay: 0
  onDialogueCompleted:
    m_PersistentCalls:
      m_Calls:
