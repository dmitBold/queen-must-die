  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NightCycle.StartDialogue
  dialoguePages:
  - "\u041D\u0430\u0448\u0443 \u0438\u043C\u043F\u0435\u0440\u0438\u044E \u043D\u0430\u0441\u0435\u043B\u044F\u044E\u0442
    \u0447\u0435\u0442\u044B\u0440\u0435 \u043D\u0430\u0440\u043E\u0434\u0430. \u0417\u043C\u0435\u0438
    \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442 \u0432 \u0448\u0430\u0445\u0442\u0430\u0445.
    \u041E\u0441\u044B \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0442 \u0443\u0440\u043E\u0436\u0430\u0439.
    \r\n"
  - "\u041F\u0430\u0443\u043A\u0438 \u0442\u043A\u0443\u0442 \u043D\u0430 \u0444\u0430\u0431\u0440\u0438\u043A\u0430\u0445.
    \u041B\u044E\u0434\u0438 \u043F\u0440\u0430\u0432\u044F\u0442 \u0432\u0441\u0435\u043C\u0438
    \u0438\u043C\u0438."
  - "\u0410 \u043A\u043E\u0433\u0434\u0430 \u044F \u0443\u0432\u0438\u0436\u0443\u2026
