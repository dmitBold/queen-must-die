--- !u!114 &1426559482
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1426559480}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 17593cab2020f8c43a7063ec459d6989, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NightCycle.NoteInteractable
  noteImage: {fileID: 21300000, guid: 0345de52d30a6d147bcf358100db9bfa, type: 3}
  noteText:
  - "\u041F\u0435\u0440\u0432\u044B\u0439 \u0434\u0435\u043D\u044C \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u043E\u0433\u043E
    \u043C\u0435\u0441\u044F\u0446\u0430 1020 \u0433\u043E\u0434\u0430\n\n\u042F
    \u043D\u0435 \u043C\u043E\u0433\u0443 \u043F\u043E\u0432\u0435\u0440\u0438\u0442\u044C,
    \u0447\u0442\u043E \u0432\u0441\u0435 \u044D\u0442\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442
    \u0441\u043E \u043C\u043D\u043E\u0439. \u041F\u0440\u043E\u0448\u0435\u043B \u0432\u0441\u0435\u0433\u043E
    \u0434\u0435\u043D\u044C, \u0430 \u044F \u0443\u0436\u0435 \u043D\u0430 \u043D\u043E\u0432\u043E\u043C
    \u043C\u0435\u0441\u0442\u0435. \u042F \u0442\u0430\u043A \u0441\u043A\u0443\u0447\u0430\u044E
    \u043F\u043E \u043C\u0430\u043C\u0435. \u042F \u0431\u043E\u044E\u0441\u044C
    \u0432\u0441\u0435\u0445 \u044D\u0442\u0438\u0445 \u043B\u044E\u0434\u0435\u0439
    \u0432\u043E\u043A\u0440\u0443\u0433. \u0412 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u0438
    \u0435\u0433\u043E.\n\n\u041E\u043D \u043D\u0430\u0437\u0432\u0430\u043B \u0441\u0435\u0431\u044F
    \u0410\u0432\u0433\u0443\u0441\u0442\u043E\u043C. \u041E\u043D \u043D\u0435 \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442
    \u043D\u0430 \u043C\u043E\u0438 \u0440\u0430\u0441\u0441\u043F\u0440\u043E\u0441\u044B,
    \u043D\u043E \u044F\u0441\u043D\u043E \u043E\u0434\u043D\u043E - \u043E\u043D
    \u0438\u0437 \u0437\u043D\u0430\u0442\u043D\u044B\u0445."
  - "\u0422\u0440\u0435\u0442\u0438\u0439 \u0434\u0435\u043D\u044C \u043F\u044F\u0442\u043E\u0433\u043E
    \u043C\u0435\u0441\u044F\u0446\u0430 1024 \u0433\u043E\u0434\u0430\n\n\u042F
    \u043D\u0430\u043A\u043E\u043D\u0435\u0446 \u043F\u0440\u0438\u0432\u044B\u043A\u043B\u0430
    \u043A \u0441\u0432\u043E\u0435\u0439 \u043D\u043E\u0432\u043E\u0439 \u043E\u0431\u0449\u0438\u043D\u0435.
    \u042D\u0442\u043E \u0434\u043E\u0431\u0440\u044B\u0435 \u0438 \u0437\u0430\u0431\u043E\u0442\u043B\u0438\u0432\u044B\u0435
    \u043B\u044E\u0434\u0438. \u041D\u043E \u0410\u0432\u0433\u0443\u0441\u0442 \u0437\u0430\u043F\u0440\u0435\u0442\u0438\u043B
    \u043C\u043D\u0435 \u0432\u044B\u0445\u043E\u0434\u0438\u0442\u044C \u0438\u0437
    \u0434\u043E\u043C\u0430 \u0434\u043E \u043D\u0430\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u044F
    \u0442\u0435\u043C\u043D\u043E\u0442\u044B. "
  - "\u0422\u0440\u0435\u0442\u0438\u0439 \u0434\u0435\u043D\u044C \u0448\u0435\u0441\u0442\u043E\u0433\u043E
    \u043C\u0435\u0441\u044F\u0446\u0430 1027 \u0433\u043E\u0434\u0430\n\n\u0410\u0432\u0433\u0443\u0441\u0442
    \u0441\u0442\u0430\u043B \u043D\u0430\u0434\u043E\u043B\u0433\u043E \u0443\u0435\u0437\u0436\u0430\u0442\u044C.
    \u042F \u0441\u0442\u0430\u043B\u0430 \u043C\u043D\u043E\u0433\u043E \u0434\u0443\u043C\u0430\u0442\u044C
    \u043E \u0442\u043E\u043C, \u043A\u0442\u043E \u043E\u043D \u0434\u043B\u044F
    \u043C\u0435\u043D\u044F. \u0414\u0440\u0443\u0433? \u0411\u0440\u0430\u0442?
    \u041E\u0442\u0435\u0446, \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043D\u0435
    \u0437\u043D\u0430\u043B\u0430?\n\n\u041E\u043D \u0441\u0442\u043E\u043B\u044C\u043A\u043E
    \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043C\u043D\u0435
    \u043F\u0440\u043E \u043C\u0438\u0440 \u0432\u043E\u043A\u0440\u0443\u0433, \u043D\u043E
    \u0437\u0430 \u044D\u0442\u0438 \u0433\u043E\u0434\u044B \u044F \u0442\u0430\u043A
    \u0438 \u043D\u0435 \u0443\u0437\u043D\u0430\u043B\u0430 \u043D\u0438\u0447\u0435\u0433\u043E
    \u043E \u043D\u0435\u043C."
  trigger_once: 1
  noteEvent:
    m_PersistentCalls:
      m_Calls: []
  interact_sound:
    Guid:
      Data1: 0
      Data2: 0
      Data3: 0
      Data4: 0
    Path: 
  trigger_sound_once: 0
  noteData: {fileID: 0}
  journalHintText: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 N, \u0447\u0442\u043E\u0431\u044B
    \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0436\u0443\u0440\u043D\u0430\u043B
    \u0437\u0430\u043F\u0438\u0441\u043E\u043A"
  journalHintDuration: 4
  journalHintFade: 0.5
