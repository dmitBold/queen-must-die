  id: Worker_Note
  NotePages:
  - "\u041C\u044B \u0437\u0430\u0441\u0442\u0440\u044F\u043B\u0438 \u0432 \u044D\u0442\u0438\u0445
    \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u044B\u0445 \u043F\u0435\u0449\u0435\u0440\u0430\u0445
    \u0443\u0436\u0435 \u043F\u043E\u043B\u0442\u043E\u0440\u0430 \u043C\u0435\u0441\u044F\u0446\u0430!
    \u041F\u0443\u0441\u0442\u044C \u044D\u0442\u043E\u0442 \u043C\u0430\u043B\u0435\u0446
    \u043D\u0435 \u043D\u0430\u0439\u0434\u0451\u0442, \u0447\u0442\u043E \u043E\u043D
    \u0438\u0449\u0435\u0442. \u0417\u0430 \u043F\u0440\u043E\u0432\u0430\u043B \u0435\u0433\u043E
    \u0443\u0431\u044C\u0451\u0442 \u043B\u0438\u0431\u043E \u043F\u0430\u043F\u0430\u0448\u0430,
    \u043B\u0438\u0431\u043E \u043A\u043E\u0440\u043E\u043B\u044C. \u0415\u0441\u043B\u0438
    \u043E\u043D \u043F\u043E\u0439\u043C\u0451\u0442, \u0447\u0442\u043E \u044D\u0442\u043E
    \u044F \u0441\u043B\u043E\u043C\u0430\u043B \u043A\u043B\u044E\u0447, \u0442\u043E
    \u044F \u043D\u0438 \u043E \u0447\u0451\u043C \u043D\u0435 \u043F\u043E\u0436\u0430\u043B\u0435\u044E."
  NoteName: "\u0417\u0430\u043F\u0438\u0441\u043A\u0430 \u0440\u0430\u0431\u043E\u0447\u0435\u0433\u043E"
  icon: {fileID: 21300000, guid: a99d56a46c4079a4989e7058665975ee, type: 3}
