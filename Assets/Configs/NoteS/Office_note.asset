  m_Script: {fileID: 11500000, guid: 6a35213657138da4bbb063f48d565b05, type: 3}
  m_Name: Office_note
  m_EditorClassIdentifier: Assembly-CSharp::Inventory.DayNoteData
  NotePages:
  - "<u>\u041F\u0435\u0440\u0432\u044B\u043C\u0438 \u043F\u0430\u043B\u0438 \u043E\u0441\u044B</u>.
    \u0421\u043E\u0442\u043D\u0438 \u043B\u0435\u0442 \u043C\u044B \u0431\u043E\u044F\u043B\u0438\u0441\u044C
    \u044D\u0442\u0438\u0445 \u0436\u0443\u0436\u0436\u0430\u0449\u0438\u0445 \u0442\u0432\u0430\u0440\u0435\u0439.
    \u041E\u043D\u0438 \u0431\u044B\u043B\u0438 \u0447\u0435\u043C-\u0442\u043E \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u043C
    \u0438 \u043E\u0442\u0442\u043E\u0433\u043E \u0447\u0435\u043C-\u0442\u043E \u0443\u0436\u0430\u0441\u0430\u044E\u0449\u0438\u043C.
    \u041D\u0430 \u0434\u0435\u043B\u0435 \u0436\u0435 \u044D\u0442\u043E \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
    \u043D\u0430\u0440\u043E\u0434 \u0441\u043B\u0430\u0431\u043E\u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043D\u044B\u0439,
    \u043D\u043E \u043C\u0443\u0434\u0440\u044B\u0439. \u041F\u0435\u0440\u0432\u044B\u0439
    \u0436\u0435 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u0441 \u043D\u0438\u043C\u0438
    \u043F\u0440\u043E\u0438\u0437\u0432\u0435\u043B \u043D\u0430 \u043C\u0435\u043D\u044F
    \u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0435 \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u0435\u043D\u0438\u0435."
  - "<u>\u0412\u0442\u043E\u0440\u044B\u043C\u0438 \u043F\u0430\u043B\u0438 \u0437\u043C\u0435\u0438</u>.
    \u041C\u044B \u0442\u043E\u043F\u0438\u043B\u0438 \u0438\u0445 \u043F\u043E\u0434\u0437\u0435\u043C\u043D\u044B\u0435
    \u0433\u043E\u0440\u043E\u0434\u0430. \u0420\u0430\u0437\u0436\u0438\u0433\u0430\u043B\u0438
    \u043A\u043E\u0441\u0442\u0440\u044B \u0432 \u0442\u0443\u043D\u043D\u0435\u043B\u044F\u0445
    \u0438 \u0437\u0430\u043F\u043E\u043B\u043D\u044F\u043B\u0438 \u0438\u0445 \u0434\u044B\u043C\u043E\u043C.
    \u0417\u0430\u0442\u0435\u043C \u043C\u044B \u0441\u043F\u0443\u0441\u043A\u0430\u043B\u0438\u0441\u044C.
    \u042F \u0432\u0438\u0434\u0435\u043B \u043F\u0435\u0440\u0435\u0434 \u0441\u043E\u0431\u043E\u0439
    \u0441\u043E\u0442\u043D\u0438 \u0431\u0435\u0437\u0436\u0438\u0437\u043D\u0435\u043D\u043D\u044B\u0445
    \u043F\u0435\u0440\u0435\u043F\u043B\u0435\u0442\u0435\u043D\u043D\u044B\u0445
    \u043C\u0435\u0436\u0434\u0443 \u0441\u043E\u0431\u043E\u0439 \u0442\u0435\u043B.
    \u041C\u043E\u0440\u0435 \u0441\u043C\u0435\u0440\u0442\u0438."
  - "<u>\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u043C\u0438 \u043F\u0430\u043B\u0438
    \u043F\u0430\u0443\u043A\u0438</u>. \u041D\u0430\u0440\u043E\u0434 \u0441\u0442\u0438\u0445\u043E\u043F\u043B\u0435\u0442\u043E\u0432!
    \u042F \u0438 \u043D\u0435 \u043C\u043E\u0433 \u043F\u043E\u0434\u0443\u043C\u0430\u0442\u044C,
    \u0447\u0442\u043E \u043E\u043D\u0438 \u0431\u0443\u0434\u0443\u0442 \u0441\u0442\u043E\u044F\u0442\u044C
    \u0434\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E \u0431\u043E\u0439\u0446\u0430.
    \u0410 \u0438\u0445 \u043B\u0438\u0434\u0435\u0440! \u201C\u0413\u0435\u0440\u043E\u0439\u201D
    \u0438\u0445 \u043D\u0430\u0440\u043E\u0434\u0430, \u0437\u0430\u043C\u0435\u043D\u0438\u0432\u0448\u0438\u0439
    \u0438\u043C \u043A\u043E\u0440\u043E\u043B\u044F... \u0414\u0430\u0436\u0435
    \u044F \u0431\u044B \u0435\u0433\u043E \u043D\u0435 \u043E\u0434\u043E\u043B\u0435\u043B,
    \u0435\u0441\u043B\u0438 \u0431\u044B \u043D\u0435 \u0435\u0433\u043E \u0441\u0435\u0441\u0442\u0440\u0430."
  NoteName: "\u0418\u0441\u0442\u043E\u0440\u0438\u044F \u0412\u043E\u0439\u043D\u044B
    \u041E\u0431\u044A\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F"
  icon: {fileID: 21300000, guid: a99d56a46c4079a4989e7058665975ee, type: 3}
