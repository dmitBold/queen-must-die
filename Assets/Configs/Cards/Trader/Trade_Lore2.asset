  m_Name: Trade_Lore2
  m_EditorClassIdentifier: Assembly-CSharp::CardData
  CardText: "\u0411\u0435\u0434\u0430 \u043D\u0430 \u042E\u0433\u0435! \u0420\u0435\u043A\u0430
    \u0432\u044B\u0448\u043B\u0430 \u0438\u0437 \u0431\u0435\u0440\u0435\u0433\u043E\u0432.
    \u0413\u0440\u044F\u0437\u044C \u0441\u043C\u044B\u043B\u0430 \u043B\u0430\u0447\u0443\u0433\u0438
    \u043A\u0440\u0435\u0441\u0442\u044C\u044F\u043D, \u043E\u043D\u0438 \u0432 \u044F\u0440\u043E\u0441\u0442\u0438.
    \u0410 \u0432\u043E\u0442 \u0443 \u043E\u0441 \u0446\u0432\u0435\u0442\u044B
    \u0441\u0442\u0430\u043B\u0438 \u0440\u0430\u0441\u0442\u0438 \u043A\u0430\u043A
    \u043D\u0430 \u0434\u0440\u043E\u0436\u0436\u0430\u0445! \u041D\u0430\u0440\u043E\u0434
    \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043A\u043E\u043C\u043F\u0435\u043D\u0441\u0430\u0446\u0438\u0439
    \u0438 \u043D\u043E\u0432\u044B\u0445 \u0434\u043E\u043C\u043E\u0432. \u0415\u0441\u043B\u0438
    \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u043D\u044F\u0442\u044C,
    \u043E\u043D\u0438 \u043E\u0431\u0432\u0438\u043D\u044F\u0442 \u0432\u043E \u0432\u0441\u0435\u0445
    \u0431\u0435\u0434\u0430\u0445 \u0443\u043B\u044C\u0438."
  LeftChoice:
