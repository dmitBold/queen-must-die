  m_Name: Trade_Pa1
  m_EditorClassIdentifier: Assembly-CSharp::CardData
  CardText: "\u0414\u0432\u043E\u0440\u044F\u043D\u0435 \u043D\u0430\u0448\u043B\u0438
    \u043B\u0430\u0437\u0435\u0439\u043A\u0443 \u0432 \u0437\u0430\u043A\u043E\u043D\u0435.
    \u041D\u0430\u043B\u043E\u0433 \u043F\u043B\u0430\u0442\u0438\u0442\u0441\u044F
    \"\u0441 \u0433\u043E\u043B\u043E\u0432\u044B\" \u0440\u0430\u0431\u0430. \u0418
    \u0432\u043E\u0442, \u043F\u0435\u0440\u0435\u0434 \u0432\u0438\u0437\u0438\u0442\u043E\u043C
    \u0441\u0431\u043E\u0440\u0449\u0438\u043A\u0430 \u043D\u0430\u043B\u043E\u0433\u043E\u0432,
    \u043E\u043D\u0438... \"\u043E\u043F\u0442\u0438\u043C\u0438\u0437\u0438\u0440\u0443\u044E\u0442
    \u0430\u043A\u0442\u0438\u0432\u044B\". \u0420\u0435\u0436\u0443\u0442 \u0441\u0442\u0430\u0440\u044B\u0445
    \u0438 \u0431\u043E\u043B\u044C\u043D\u044B\u0445 \u043D\u0435\u043B\u044E\u0434\u0435\u0439,
    \u0447\u0442\u043E\u0431\u044B \u043F\u043B\u0430\u0442\u0438\u0442\u044C \u043C\u0435\u043D\u044C\u0448\u0435.
    \u041A\u0430\u0437\u043D\u0430 \u043F\u0443\u0441\u0442\u0435\u0435\u0442, \u0430
    \u0440\u0432\u044B \u043F\u043E\u043B\u043D\u044B \u0442\u0440\u0443\u043F\u043E\u0432."
  LeftChoice:
    text: "\u0412\u043D\u0435\u0441\u0442\u0438 \u043F\u0440\u0430\u0432\u043A\u0438
      \u0432 \u0437\u0430\u043A\u043E\u043D"
