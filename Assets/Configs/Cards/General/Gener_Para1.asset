  CardText: "\u041C\u044B \u0432\u0441\u043A\u0440\u044B\u043B\u0438 \u043F\u043E\u0434\u0432\u0430\u043B
    \u043E\u0434\u043D\u043E\u0433\u043E \u043F\u043E\u043A\u043E\u0439\u043D\u043E\u0433\u043E
    \u0438\u043D\u0442\u0435\u043D\u0434\u0430\u043D\u0442\u0430. \u0421\u0442\u0430\u0440\u044B\u0439
    \u043F\u0451\u0441 \u043F\u0440\u044F\u0442\u0430\u043B \u0442\u0430\u043C \u0433\u043E\u0440\u0443
    \u043E\u0442\u043B\u0438\u0447\u043D\u044B\u0445 \u043A\u043B\u0438\u043D\u043A\u043E\u0432,
    \u0430 \u0433\u043B\u0430\u0432\u043D\u043E\u0435 - \u043F\u043E\u043B\u0441\u043E\u0442\u043D\u0438
    \u0433\u043E\u043B\u0435\u043C\u043E\u0432 \u0432 \u0441\u043F\u044F\u0447\u043A\u0435.
    \u042D\u0442\u043E \u043E\u0440\u0443\u0436\u0438\u0435 \u043F\u043E \u043F\u0440\u0430\u0432\u0443
    \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0438\u0442 \u0430\u0440\u043C\u0438\u0438!
