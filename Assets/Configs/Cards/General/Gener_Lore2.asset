  CardText: "\u0421\u0442\u0440\u0430\u0436\u0430 \u0441\u043F\u0443\u0433\u043D\u0443\u043B\u0430
    \u043B\u0430\u0437\u0443\u0442\u0447\u0438\u043A\u0430, \u043F\u044B\u0442\u0430\u0432\u0448\u0435\u0433\u043E\u0441\u044F
    \u043F\u0440\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u0432 \u0437\u0430\u043C\u043E\u043A.
    \u0421\u0438\u043B\u0443\u044D\u0442 \u0431\u044B\u043B \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0438\u0439.
    \u041C\u043E\u0436\u0435\u0442, \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043A\u0430\u0436\u0435\u043C
    \u043D\u0430\u0440\u043E\u0434\u0443, \u0447\u0442\u043E \u044D\u0442\u043E \u0431\u044B\u043B
    \u0430\u0441\u0441\u0430\u0441\u0438\u043D-\u043D\u0435\u043B\u044E\u0434\u044C?
    \u042D\u0442\u043E \u0441\u043F\u043B\u043E\u0442\u0438\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0438\u0445
    \u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u043A\u043E\u0432"
  LeftChoice:
    text: "\u041D\u0430\u0439\u0442\u0438 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0433\u043E
      \u043F\u0440\u0435\u0441\u0442\u0443\u043F\u043D\u0438\u043A\u0430"
