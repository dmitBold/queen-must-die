  m_EditorClassIdentifier: Assembly-CSharp::CardData
  CardText: "\u041B\u0435\u0433\u0438\u043E\u043D\u044B \u0432 \u043A\u0440\u0438\u0437\u0438\u0441\u0435.
    \u041E\u0444\u0438\u0446\u0435\u0440\u044B \u043F\u044F\u0442\u043E\u0433\u043E
    \u0438\u0441\u0447\u0435\u0437\u043B\u0438, \u0441\u043E\u043B\u0434\u0430\u0442\u044B 
    \u043D\u0430\u0447\u0430\u043B\u0438 \u0433\u0440\u043E\u043C\u0438\u0442\u044C
    \u0442\u043A\u0430\u0446\u043A\u0438\u0435 \u0434\u0435\u0440\u0435\u0432\u043D\u0438
    \u043F\u0430\u0443\u043A\u043E\u0432. \u041F\u0430\u0443\u043A\u0438 \u0432\u043E\u044E\u0442,
    \u043D\u043E \u0441\u043E\u043B\u0434\u0430\u0442\u044B \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B
    \u0434\u043E\u0431\u044B\u0447\u0435\u0439. \u041A\u0430\u043A \u0432\u044B \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442\u0435,
    \u0441\u043E\u043B\u0434\u0430\u0442 \u043C\u044B \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C
    \u0434\u043B\u044F \u0437\u0430\u0449\u0438\u0442\u044B \u043D\u0435\u043B\u044E\u0434\u0435\u0439
    \u043D\u0435 \u043C\u043E\u0436\u0435\u043C, \u043A\u043E\u0433\u0434\u0430 \u0441\u0430\u043C\u0438
    \u0441\u043E\u043B\u0434\u0430\u0442\u044B \u0433\u0440\u0430\u0431\u044F\u0442
    \u0438\u0445."
