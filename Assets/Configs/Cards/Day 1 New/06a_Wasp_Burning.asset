  m_EditorClassIdentifier: Assembly-CSharp::CardData
  CardPages:
  - "\u041C\u0438\u043B\u043B\u0438\u043E\u043D\u044B \u0440\u0430\u0431\u043E\u0447\u0438\u0445
    \u0432\u043E\u043F\u044F\u0442 \u0432 \u043C\u0443\u043A\u0430\u0445, \u0433\u043E\u0441\u043F\u043E\u0436\u0430!
    \u041B\u044E\u0434\u0438 \u0436\u0433\u0443\u0442 \u0443\u043B\u044C\u0438, \u0447\u0442\u043E\u0431\u044B
    \u043F\u043E\u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
    \u0437\u0435\u043C\u043B\u0438."
  - "\u041C\u044B \u043E\u0442\u0434\u0430\u043B\u0438 \u0441\u0432\u043E\u0438 \u0437\u0435\u043C\u043B\u0438
    \u0431\u0435\u0437 \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u044F!
    \u041F\u043E\u0448\u043B\u0438\u0442\u0435 \u0432\u043E\u0439\u0441\u043A\u0430,
    \u0447\u0442\u043E\u0431\u044B \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
    \u0431\u043E\u0439\u043D\u044E!"
  Card_name: "\u041D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u0446\u0430 \u043E\u0441"
  LeftChoice:
    text: "\u041F\u043E\u043C\u043E\u0447\u044C"
