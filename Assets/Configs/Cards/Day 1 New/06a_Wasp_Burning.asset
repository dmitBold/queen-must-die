    removeFlags: []
    reactionText:
    - "\u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u0443\u0441\u043F\u0435\u043B
      \u0447\u0435\u043C\u0443-\u0442\u043E \u043D\u0430\u0443\u0447\u0438\u0442\u044C
      \u0432\u0430\u0441. \u0414\u0443\u043C\u0430\u044E, \u043E\u043D \u0431\u044B
      \u0445\u043E\u0442\u0435\u043B, \u0447\u0442\u043E\u0431\u044B \u0432\u044B
      \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438 \u044D\u0442\u043E."
    - "\u041E\u043D \u043E\u0442\u0434\u0430\u043B \u043C\u043D\u0435 \u044D\u0442\u043E
      \u043D\u0430 \u0441\u043B\u0443\u0447\u0430\u0439, \u0435\u0441\u043B\u0438
      \u0443\u043C\u0440\u0451\u0442 \u0431\u0435\u0437 \u0434\u043E\u0441\u0442\u043E\u0439\u043D\u043E\u0433\u043E
      \u043D\u0430\u0441\u043B\u0435\u0434\u043D\u0438\u043A\u0430."
    - "\xAB\u041A\u043D\u0438\u0433\u0430 \u0432\u0441\u0430\u0434\u043D\u0438\u043A\u0430
      \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0438\u0445 \u0442\u0430\u0439\u043D\u044B\xBB.
      \u0422\u0430\u043A \u043E\u043D \u043C\u043D\u0435 \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043B
      \u0441\u0432\u043E\u0439 \u0434\u0430\u0440."
    - "\u042F \u0432\u0438\u0436\u0443, \u0447\u0442\u043E \u0432\u044B \u0434\u043E\u0441\u0442\u043E\u0439\u043D\u044B."
