  CardText: "\u041C\u043E\u0438 \u0441\u043E\u0440\u043E\u0434\u0438\u0447\u0438
    \u0438\u0437 \u0431\u043B\u0430\u0433\u043E\u0440\u043E\u0434\u043D\u044B\u0445
