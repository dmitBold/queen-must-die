    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u0440\u043E\u043B\u044C\u0451\u0442
    \u044D\u0442\u0443 \u043A\u0440\u043E\u0432\u044C. \u041D\u043E \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u044F
    \u043D\u0435 \u043F\u0440\u0438\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
    \u043A\u043E\u0432\u0430\u0442\u044C \u0435\u0433\u043E."
  Card_name: "\u0413\u0435\u043D\u0435\u0440\u0430\u043B \u0413\u0435\u0444\u0435\u0441\u0442\u0438\u043E\u043D"
