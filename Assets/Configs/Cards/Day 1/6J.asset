  m_Script: {fileID: 11500000, guid: 00c7e4b39926d0b42b78e88af0359330, type: 3}
  m_Name: 6J
  m_EditorClassIdentifier: Assembly-CSharp::CardData
  CardPages:
  - "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435. \u042F
    - \u0414\u0436\u0443\u043B \u0421\u0435\u043B\u0435\u0432\u043A\u0438\u0434.
    \u041D\u0430\u0441\u043B\u0435\u0434\u043D\u0438\u0446\u0430 \u0441\u0432\u043E\u0435\u0433\u043E
    \u0440\u043E\u0434\u0430 \u0438, \u043F\u043E \u0441\u0435\u043A\u0440\u0435\u0442\u0443,
    \u0430\u0433\u0435\u043D\u0442 \u043A\u043E\u0440\u043E\u043D\u044B! \u042F \u0441\u043B\u0435\u0436\u0443
    \u0437\u0430 \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044F\u043C\u0438
    \u044D\u043B\u0438\u0442\u044B."
  - "\u0421\u0442\u043E\u0439\u0442\u0435. \u0412\u044B \u0436\u0435 \u0442\u0435\u043F\u0435\u0440\u044C
    \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0430. \u041C\u043E\u0436\u043D\u043E
    \u043D\u0435 \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0438\u0442\u0441\u044F
    \u043E \u0441\u0435\u043A\u0440\u0435\u0442\u0430\u0445!"
  - "\u042F \u043F\u0440\u0438\u0448\u043B\u0430 \u043A \u0432\u0430\u043C \u0441
    \u043B\u0438\u0447\u043D\u043E\u0439 \u043F\u0440\u043E\u0441\u044C\u0431\u043E\u0439.
    \u041C\u043E\u0433\u043B\u0438 \u0431\u044B \u0432\u044B \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
    \u043E \u043D\u0435\u0439 \u043C\u043E\u0438\u043C \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u044F\u043C?"
  - "\u0412\u043F\u0440\u043E\u0447\u0435\u043C, \u0443 \u043C\u0435\u043D\u044F
    \u0443\u0436\u0435 \u043D\u0435 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C
    \u0432\u044B\u0431\u043E\u0440\u0430."
  - "\u041C\u043E\u0451 \u0441\u0435\u0440\u0434\u0446\u0435 \u0432\u044B\u0431\u0440\u0430\u043B\u043E
    \u0442\u043E\u0433\u043E, \u043A\u043E\u0433\u043E \u043D\u0435 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
    \u043C\u043E\u044F \u0441\u0435\u043C\u044C\u044F. \u041F\u043E\u043C\u0438\u043C\u043E
    \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0435\u0439 \u0442\u043E\u043B\u044C\u043A\u043E
    \u043A\u043E\u0440\u043E\u043D\u0430 \u043C\u043E\u0436\u0435\u0442 \u043E\u0434\u043E\u0431\u0440\u0438\u0442\u044C
    \u043D\u0430\u0448 \u0441\u043E\u044E\u0437!"
  Card_name: "\u0414\u0436\u0443\u043B \u0421\u0435\u043B\u0435\u0432\u043A\u0438\u0434"
  LeftChoice:
    text: "\u041A\u0442\u043E \u0438\u0437\u0431\u0440\u0430\u043D\u043D\u0438\u043A?"
    effects:
    - type: 0
      stat: 4
      value: 10
    addFlags:
    - 1.6
    removeFlags: []
    reactionText:
    - "\u042F \u0437\u043D\u0430\u043B\u0430, \u0447\u0442\u043E \u0432\u044B \u043F\u043E\u043C\u043E\u0436\u0435\u0442\u0435!
      \u041F\u043E\u043C\u043E\u0436\u0435\u0442\u0435 \u0432\u0435\u0434\u044C?"
    - "\u041E\u043D \u0438\u0434\u0451\u0442 \u0437\u0430 \u043C\u043D\u043E\u0439.
      \u041E\u043D \u0442\u0430\u043A \u043A\u0440\u0430\u0441\u0438\u0432! \u041D\u043E
      \u0432 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u043C \u0432\u043D\u0443\u0442\u0440\u0438..."
    rewardItem: {fileID: 0}
    rewardNote: {fileID: 0}
    rewardAmount: 1
  RightChoice:
    text: "\u042F \u043D\u0435 \u0437\u0430\u043D\u0438\u043C\u0430\u044E\u0441\u044C
      \u0442\u0430\u043A\u0438\u043C"
    effects: []
    addFlags:
    - 1.6
