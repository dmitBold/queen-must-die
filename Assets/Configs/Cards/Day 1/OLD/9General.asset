  Card_name: "\u0413\u0435\u043D\u0435\u0440\u0430\u043B \u0413\u0435\u0444\u0435\u0441\u0442\u0438\u043E\u043D"
  LeftChoice:
    text: "\u042F \u0445\u043E\u0447\u0443 \u0437\u043D\u0430\u0442\u044C"
    effects: []
    addFlags:
    - 1.9
    removeFlags: []
    reactionText:
    - "\u0414\u0435\u0440\u0435\u0432\u043D\u044F \u0441\u0433\u043E\u0440\u0435\u043B\u0430
      \u0434\u043E\u0442\u043B\u0430, \u0430 \u0432\u0441\u0435 \u0436\u0438\u0442\u0435\u043B\u0438
      \u043F\u0435\u0440\u0435\u0431\u0438\u0442\u044B."
    - "\u041E\u043D\u0438 \u0437\u0430\u0445\u043E\u0440\u043E\u043D\u0435\u043D\u044B
      \u0432 \u043E\u0431\u0449\u0435\u0439 \u043C\u043E\u0433\u0438\u043B\u0435.
      \u0422\u043E\u0447\u043D\u0435\u0435, \u044F\u043C\u0435."
    - "\u041F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044C \u0434\u043E\u043B\u0436\u0435\u043D
      \u0431\u044B\u0442\u044C \u043E\u0441\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D
      \u043E \u0432\u0441\u0435\u043C, \u0447\u0442\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442
      \u0438\u043B\u0438 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u043B\u043E
      \u0432 \u0435\u0433\u043E \u0432\u043B\u0430\u0434\u0435\u043D\u0438\u044F\u0445..."
