  m_Name: 01_General_Army
  m_EditorClassIdentifier: Assembly-CSharp::CardData
  CardPages:
  - "\u042F \u0440\u043E\u0441 \u0438 \u0443\u0431\u0438\u0432\u0430\u043B \u0431\u043E\u043A
    \u043E \u0431\u043E\u043A \u0441 \u0432\u0430\u0448\u0438\u043C \u043E\u0442\u0446\u043E\u043C."
  - "\u041E\u0434\u043D\u0430\u0436\u0434\u044B \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440
    \u0437\u0430\u043A\u0430\u0442\u0438\u043B \u043F\u0438\u0440. \u0413\u043B\u0430\u0432\u043D\u044B\u043C
    \u0431\u043B\u044E\u0434\u043E\u043C \u0431\u044B\u043B \u0410\u0440\u0430\u043A,
    \u0442\u043E\u043B\u044C\u043A\u043E \u0447\u0442\u043E \u043F\u043E\u0432\u0435\u0440\u0436\u0435\u043D\u043D\u044B\u0439
    \u043F\u0440\u0435\u0434\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C \u043F\u0430\u0443\u043A\u043E\u0432."
  - "\u0422\u043E\u043B\u044C\u043A\u043E \u041A\u043E\u0440\u043E\u043B\u044C \u0432\u0437\u044F\u043B
    \u0432 \u0440\u0443\u043A\u0438 \u043A\u0443\u0441\u043E\u043A, \u043A\u0430\u043A
    \u0433\u043B\u0430\u0437 \u0432 \u0435\u0433\u043E \u043A\u043E\u0440\u043E\u043D\u0435
    \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F. \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440
    \u0431\u0440\u043E\u0441\u0438\u043B \u0435\u0434\u0443."
  - "\u0410\u0440\u0430\u043A \u0437\u043D\u0430\u043B, \u0447\u0442\u043E \u043C\u044B
    \u0435\u0434\u0438\u043C \u0434\u043E\u0441\u0442\u043E\u0439\u043D\u044B\u0445
    \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u0432. \u041E\u043D
    \u043D\u0430\u043F\u043E\u043B\u043D\u0438\u043B \u0441\u0432\u043E\u0451 \u0442\u0435\u043B\u043E
    \u0442\u043E\u043A\u0441\u0438\u043D\u0430\u043C\u0438."
  - "\u0427\u0442\u043E-\u0442\u043E \u0432 \u044D\u0442\u043E\u0439 \u043A\u043E\u0440\u043E\u043D\u0435
    \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u043B\u043E \u043A\u043E\u0440\u043E\u043B\u044E.
    \u0415\u0441\u043B\u0438 \u0432\u044B \u0438 \u043F\u0440\u0430\u0432\u0434\u0430
    \u0410\u0440\u0433\u0435\u0430\u0434, \u043E\u043D\u043E \u043F\u043E\u0434\u0441\u043A\u0430\u0436\u0435\u0442
    \u0438 \u0432\u0430\u043C."
  - "\u0418\u0442\u0430\u043A, \u043C\u043E\u044F \u043F\u0435\u0440\u0432\u0430\u044F
    \u043F\u0440\u043E\u0441\u044C\u0431\u0430: \u0434\u0430\u0439\u0442\u0435 \u043C\u043D\u0435
    \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u043D\u0430\u0431\u0438\u0440\u0430\u0442\u044C
    \u043D\u0435\u043B\u044E\u0434\u0435\u0439 \u0432 \u0430\u0440\u043C\u0438\u044E."
