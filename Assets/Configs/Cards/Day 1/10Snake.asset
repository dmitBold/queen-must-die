  CardText: "\u0417\u0430\u043C\u043E\u043A \u0410\u0440\u0433\u0435\u0430\u0434\u043E\u0432
    - \u0441\u0430\u043C\u043E\u0435 \u043E\u0445\u0440\u0430\u043D\u044F\u0435\u043C\u043E\u0435
    \u043C\u0435\u0441\u0442\u043E \u0432 \u0438\u043C\u043F\u0435\u0440\u0438\u0438.
    \u0415\u0441\u043B\u0438 \u043A\u0442\u043E-\u0442\u043E \u0438 \u0441\u043C\u043E\u0436\u0435\u0442
    \u043F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E \u043C\u043E\u0438\u0445
    \u043B\u044E\u0434\u0435\u0439, \u0442\u043E \u0435\u043C\u0443 \u043D\u0435
    \u043F\u0435\u0440\u0435\u0436\u0438\u0442\u044C \u0432\u0441\u0442\u0440\u0435\u0447\u0443
    \u0441 \u0433\u043E\u043B\u0435\u043C\u043E\u043C."
  LeftChoice:
    text: "\u0427\u0442\u043E \u044D\u0442\u043E?"
    effects: []
    addFlags:
    - 1.10
    removeFlags: []
    reactionText: "\u0413\u043B\u0430\u0432\u043D\u043E\u0435 \u043E\u0440\u0443\u0436\u0438\u0435
      \u0432\u043E\u0439\u043D\u044B \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F.
      \u0413\u043E\u043B\u0435\u043C \u0442\u0438\u043F\u0430 IV \u0441\u043F\u043E\u0441\u043E\u0431\u0435\u043D
      \u0432 \u043E\u0434\u0438\u043D\u043E\u0447\u043A\u0443 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u0442\u044C
      \u0441\u043E\u0442\u043D\u044E \u043F\u0430\u0443\u043A\u043E\u0432. \u041C\u043E\u0436\u0435\u0442\u0435
      \u0441\u043F\u0430\u0442\u044C \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E,
      \u043F\u043E\u043A\u0430 \u0445\u043E\u0442\u044F \u0431\u044B \u043E\u0434\u0438\u043D
      \u0442\u0430\u043A\u043E\u0439 \u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442
      \u0432\u0430\u0448\u0438 \u043F\u043E\u043A\u043E\u0438!"
