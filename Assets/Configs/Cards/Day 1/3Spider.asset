  m_Name: 3Spider
  m_EditorClassIdentifier: Assembly-CSharp::CardData
  CardText: "\u042F \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u0432\u044B \u0438\u0449\u0438\u0442\u0435
    \u043E\u0434\u043D\u043E\u0433\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430.
    \u041E\u043D \u043F\u043E\u0434\u0430\u0440\u0438\u043B \u0432\u0430\u043C \u043D\u0435\u043A\u0443\u044E
    \u043C\u0443\u0437\u044B\u043A\u0430\u043B\u044C\u043D\u0443\u044E \u0448\u043A\u0430\u0442\u0443\u043B\u043A\u0443.
    \u0414\u0430, \u0434\u0430\u0436\u0435 \u0443 \u043D\u0435\u043B\u044E\u0434\u0435\u0439
    \u0435\u0441\u0442\u044C \u0443\u0448\u0438 \u043F\u0440\u0438 \u0434\u0432\u043E\u0440\u0435.
    \u042D\u0442\u0430 \u0448\u043A\u0430\u0442\u0443\u043B\u043A\u0430 - \u043F\u0430\u0443\u0447\u044C\u044F
    \u0440\u0430\u0431\u043E\u0442\u0430. \u042F \u043C\u043E\u0433\u0443 \u043D\u0430\u0439\u0442\u0438
    \u0435\u0451 \u0441\u043E\u0437\u0434\u0430\u0442\u0435\u043B\u044F, \u0430 \u043E\u043D
    \u0441\u043A\u0430\u0436\u0435\u0442 \u043C\u043D\u0435 \u0438\u043C\u044F \u0437\u0430\u043A\u0430\u0437\u0447\u0438\u043A\u0430.
    \u041C\u043D\u0435 \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u044E\u0442\u0441\u044F
    \u0434\u043B\u044F \u044D\u0442\u043E\u0433\u043E \u043D\u0435\u043C\u043D\u043E\u0433\u043E
    \u0437\u043E\u043B\u043E\u0442\u0430"
