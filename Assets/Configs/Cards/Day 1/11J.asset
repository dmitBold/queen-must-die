    reactionText: "\u0425\u043C, \u044D\u0442\u043E \u043F\u043B\u0430\u0442\u044C\u0435
      \u0442\u043E\u0447\u043D\u043E \u0437\u0430\u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0443\u0435\u0442
      \u043D\u0430\u0448\u0438\u0445 \u0434\u0430\u043C, \u0430 \u0437\u043D\u0430\u0447\u0438\u0442
      \u043E\u043D\u0438 \u0437\u0430\u0445\u043E\u0442\u044F\u0442 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
      \u0441 \u0438\u0445 \u0441\u043E\u0437\u0434\u0430\u0442\u0435\u043B\u044F\u043C\u0438.
