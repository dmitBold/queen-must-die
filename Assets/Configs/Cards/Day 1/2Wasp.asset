    \u0438 \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F."
  - "\u0412\u043E \u0432\u0440\u0435\u043C\u044F \u0432\u043E\u0439\u043D\u044B \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440
    \u0438\u0441\u0442\u0440\u0435\u0431\u0438\u043B \u0431\u043E\u043B\u044C\u0448\u0435
    \u0432\u043E\u0441\u044C\u043C\u0438 \u043C\u0438\u043B\u043B\u0438\u043E\u043D\u043E\u0432
    \u043D\u0435\u043B\u044E\u0434\u0435\u0439, \u043D\u043E \u043E\u0441\u0442\u0430\u0432\u0438\u043B
    \u043D\u0430\u0441..."
  - "\u0422\u0435\u0445, \u043A\u0442\u043E \u043D\u0435 \u043C\u043E\u0436\u0435\u0442
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C \u0431\u0435\u0437
