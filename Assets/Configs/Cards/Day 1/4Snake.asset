  CardText: "\u0412\u044B\u043D\u0443\u0436\u0434\u0435\u043D \u043D\u0430\u0447\u0430\u0442\u044C
    \u043D\u0430\u0448\u0435 \u0437\u043D\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u043E
    \u0441 \u0434\u0443\u0440\u043D\u044B\u0445 \u0432\u0435\u0441\u0442\u0435\u0439.
