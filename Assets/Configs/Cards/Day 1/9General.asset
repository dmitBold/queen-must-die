  CardText: "\u0412\u044B \u043D\u0435 \u0437\u0430\u0441\u0442\u0430\u043B\u0438
    \u0432\u043E\u0439\u043D\u0443 \u0438 \u043D\u0435 \u0432\u0438\u0434\u0435\u043B\u0438
    \u043D\u0430\u0448\u0443 \u0430\u0440\u043C\u0438\u044E \u0432 \u0441\u0430\u043C\u043E\u043C
    \u0440\u0430\u0441\u0446\u0432\u0435\u0442\u0435. \u0411\u0438\u0442\u0432\u044B
    \u043E\u0431\u0435\u0441\u043A\u0440\u043E\u0432\u0438\u043B\u0438 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u0442\u0432\u043E,
    \u0438 \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u043A \u0440\u0435\u043A\u0440\u0443\u0442\u043E\u0432
    \u043D\u0435\u043A\u0435\u043C \u0432\u043E\u0441\u043F\u043E\u043B\u043D\u0438\u0442\u044C.
    \u041C\u044B \u043C\u043E\u0436\u0435\u043C \u043D\u0430\u0447\u0430\u0442\u044C
    \u0437\u0430\u0433\u043E\u043D\u044F\u0442\u044C \u0432 \u0441\u0442\u0440\u043E\u0439
    \u043D\u0435\u043B\u044E\u0434\u0435\u0439 \u0438 \u043F\u0443\u0441\u043A\u0430\u0442\u044C
    \u0438\u0445 \u0432 \u0430\u0432\u0430\u043D\u0433\u0430\u0440\u0434, \u0447\u0442\u043E\u0431\u044B
    \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C \u0431\u043E\u043B\u0435\u0435
    \u0446\u0435\u043D\u043D\u044B\u0445 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0438\u0445
    \u0431\u043E\u0439\u0446\u043E\u0432."
