  m_Name: 1GenerTutor
  m_EditorClassIdentifier: Assembly-CSharp::CardData
  CardPages:
  - "\u0422\u0430\u043A \u0441\u0442\u0440\u0430\u043D\u043D\u043E. \u0415\u0449\u0451
    \u0432\u0447\u0435\u0440\u0430 \u0437\u0434\u0435\u0441\u044C \u0441\u0438\u0434\u0435\u043B
    \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440, \u0430 \u0442\u0435\u043F\u0435\u0440\u044C
    \u044F \u0432\u0438\u0436\u0443 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0443\u044E
    \u0434\u0435\u0432\u043E\u0447\u043A\u0443."
  - "\u042F \u043D\u0430\u0447\u0438\u043D\u0430\u043B \u0441\u0432\u043E\u0439 \u043F\u0443\u0442\u044C
    \u0441 \u043D\u0438\u043C, \u043A\u043E\u0433\u0434\u0430 \u043C\u044B \u0431\u044B\u043B\u0438
    \u0432 \u0442\u043E\u043C \u0436\u0435 \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0435,
    \u0447\u0442\u043E \u0438 \u0432\u044B \u0441\u0435\u0439\u0447\u0430\u0441."
  - "\u042F \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u044B\u043B \u0432\u0435\u0440\u0435\u043D
    \u0435\u043C\u0443 \u0438 \u0431\u0443\u0434\u0443 \u0432\u0435\u0440\u0435\u043D
    \u0432\u0430\u043C. \u041C\u043E\u0438 \u043B\u0435\u0433\u0438\u043E\u043D\u044B
    \u0441\u0434\u0435\u043B\u0430\u044E\u0442 \u0432\u0441\u0451, \u0447\u0442\u043E
    \u0432\u044B \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0435."
  - "\u041D\u043E \u043E\u043D\u0438 \u043D\u0435 \u0441\u043C\u043E\u0433\u043B\u0438
    \u0443\u0431\u0435\u0440\u0435\u0447\u044C \u0432\u0430\u0448\u0435\u0433\u043E
    \u043E\u0442\u0446\u0430. \u041D\u0435 \u0432\u0435\u0440\u044C\u0442\u0435 \u043D\u0438\u043A\u043E\u043C\u0443
    \u0437\u0434\u0435\u0441\u044C, \u043C\u043E\u044F \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0430."
  - "\u041A\u0442\u043E \u0431\u044B \u043D\u0438 \u0431\u044B\u043B \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u0435\u043D
    \u0437\u0430 \u0441\u043C\u0435\u0440\u0442\u044C \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440\u0430,
    \u043E\u043D \u0432\u0441\u0451 \u0435\u0449\u0451 \u0441\u0440\u0435\u0434\u0438
    \u043D\u0430\u0441."
  Card_name: "\u0413\u0435\u043D\u0435\u0440\u0430\u043B \u0413\u0435\u0444\u0435\u0441\u0442\u0438\u043E\u043D"
  LeftChoice:
    text: "\u042F \u0431\u0443\u0434\u0443 \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u0430"
