    \u043B\u0438\u0448\u044C \u0432\u0435\u0434\u0443 \u0443\u0447\u0451\u0442. \u041A\u0441\u0442\u0430\u0442\u0438
    \u043E\u0431 \u0443\u0447\u0451\u0442\u0435."
  - "\u0421\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u043A\u0430\u0437\u043D\u044B
    \u0442\u0430\u043A \u0441\u0435\u0431\u0435. \u041D\u0443\u0436\u043D\u043E \u0441\u0440\u043E\u0447\u043D\u043E
    \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u0431\u043E\u043B\u044C\u0448\u0435
    \u0437\u043E\u043B\u043E\u0442\u0430."
  - "\u041E\u0434\u043D\u0430 \u0438\u0437 \u0437\u043D\u0430\u0442\u043D\u044B\u0445
    \u0441\u0435\u043C\u0435\u0439 \u043A\u0430\u043A \u0440\u0430\u0437 \u0433\u043E\u0442\u043E\u0432\u0430
    \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0437\u0430 \u0447\u0430\u0441\u0442\u044C
    \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0439 \u043E\u0441\u0438\u043D\u043E\u0439
    \u043F\u0440\u043E\u0432\u0438\u043D\u0446\u0438\u0438."
  - "\u0424\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E \u043C\u0435\u0441\u0442\u043D\u043E\u0435 \u043D\u0430\u0441\u0435\u043B\u0435\u043D\u0438\u0435
