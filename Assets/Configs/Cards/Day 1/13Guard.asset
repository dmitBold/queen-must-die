  m_Name: 13Guard
  m_EditorClassIdentifier: Assembly-CSharp::CardData
  CardPages:
  - "\u041A\u0430\u043A \u0432\u044B \u043D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430
    \u0437\u043D\u0430\u0435\u0442\u0435, \u043F\u043E\u0441\u043B\u0435 \u0441\u043C\u0435\u0440\u0442\u0438
    \u043A\u043E\u0440\u043E\u043B\u044F \u0410\u0440\u0433\u0435\u0430\u0434\u043E\u0432
    \u0435\u0433\u043E \u0433\u0432\u0430\u0440\u0434\u0438\u044F \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0441 \u043D\u0438\u043C \u043D\u0430 \u043D\u043E\u0432\u044B\u0435 \u0432\u043E\u0439\u043D\u044B."
  - "\u0413\u0432\u0430\u0440\u0434\u0435\u0439\u0446\u044B \u043F\u043E\u0447\u0438\u0432\u0448\u0435\u0433\u043E
    \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440\u0430 \u0442\u0440\u0435\u0431\u0443\u044E\u0442
    \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u044D\u0442\u0443
    \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u044E. "
  - "\u041E\u043D\u0438 \u0437\u0430\u043A\u043E\u043D\u0447\u0430\u0442 \u0441\u0432\u043E\u044E
    \u0437\u0435\u043C\u043D\u0443\u044E \u0436\u0438\u0437\u043D\u044C \u0438 \u0432\u0441\u0442\u0440\u0435\u0442\u044F\u0442
    \u0441\u0432\u043E\u0435\u0433\u043E \u043A\u043E\u0440\u043E\u043B\u044F \u043F\u043E
    \u0442\u0443 \u0441\u0442\u043E\u0440\u043E\u043D\u0443. "
  - "\u041D\u043E \u0432\u044B \u0434\u043E\u043B\u0436\u043D\u044B \u0443\u0447\u0438\u0442\u044B\u0432\u0430\u0442\u044C,
    \u0447\u0442\u043E \u0443 \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440\u0430
    \u0431\u044B\u043B\u043E \"\u043D\u0435\u043C\u043D\u043E\u0433\u043E\" \u0431\u043E\u043B\u044C\u0448\u0435
    \u0433\u0432\u0430\u0440\u0434\u0435\u0439\u0446\u0435\u0432, \u0447\u0435\u043C
    \u0443 \u0435\u0433\u043E \u043E\u0442\u0446\u0430."
  Card_name: "\u0413\u0432\u0430\u0440\u0434\u0435\u0435\u0446 \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440\u0430"
