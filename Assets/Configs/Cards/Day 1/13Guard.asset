    reactionText:
    - "\u041A\u0430\u043A \u0432\u044B \u043D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430
      \u0437\u043D\u0430\u0435\u0442\u0435, \u0433\u0432\u0430\u0440\u0434\u0435\u0439\u0446\u044B
      \u043F\u043E\u043B\u0443\u0447\u0430\u0442 \u0441\u0432\u043E\u0438 \u0441\u0442\u0430\u0442\u0443\u0438-\u0441\u0430\u0440\u043A\u043E\u0444\u0430\u0433\u0438."
    - "\u0412 \u043D\u0438\u0445 \u0431\u0443\u0434\u0443\u0442 \u0437\u0430\u043A\u043B\u044E\u0447\u0435\u043D\u044B
      \u0438\u0445 \u0441\u043C\u0435\u0440\u0442\u043D\u044B\u0435 \u0442\u0435\u043B\u0430,
      \u0430 \u0437\u0430\u0442\u0435\u043C \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u044B
      \u043F\u043E \u0437\u0430\u043C\u043A\u0443 \u0410\u0440\u0433\u0435\u0430\u0434."
    - "\u041A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C \u043D\u043E\u0432\u044B\u0435
      \u0433\u0432\u0430\u0440\u0434\u0435\u0439\u0446\u044B \u0437\u0430\u0445\u043E\u0442\u044F\u0442
      \u0441\u0432\u044F\u0437\u0430\u0442\u044C \u0441\u0435\u0431\u044F \u0441
      \u041A\u043E\u0440\u043E\u043B\u0435\u0432\u043E\u0439 \u0411\u0435\u0442 \u0410\u0440\u0433\u0435\u0430\u0434.
      \u041D\u0430\u0432\u0435\u0447\u043D\u043E."
