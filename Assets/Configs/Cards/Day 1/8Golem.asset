  m_Name: 8Golem
  m_EditorClassIdentifier: Assembly-CSharp::CardData
  CardPages:
  - "\u041F\u0440\u043E\u0448\u0443 \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
    - \u0433\u043E\u043B\u0435\u043C \u0442\u0438\u043F\u0430 IV! \u0412\u0430\u0448\u0430
    \u0433\u0432\u0430\u0440\u0434\u0438\u044F \u0438 \u0442\u0430\u043A\u0438\u0435
    \u0436\u0435, \u043A\u0430\u043A \u043E\u043D, \u043E\u0445\u0440\u0430\u043D\u044F\u044E\u0442
    \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u0438\u0439 \u0437\u0430\u043C\u043E\u043A."
  - "\u042D\u0442\u043E... \u043B\u044E\u0434\u0438. \u0418\u0445 \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0442
    \u0438\u0437 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445 \u0442\u0435\u043B
    \u0432 \u043D\u043E\u0447\u044C \u0442\u0430\u0439\u043D, \u0432\u0434\u044B\u0445\u0430\u044E\u0442
    \u0436\u0438\u0437\u043D\u044C \u0438 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u044E\u0442
    \u0435\u0451 \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u043E\u0432."
  - "\u041E\u043D\u0438 \u043C\u0430\u0441\u0441\u043E\u0432\u043E \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u043B\u0438\u0441\u044C
    \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0432\u043E\u0439\u043D\u044B, \u0430
    \u0442\u0435\u043F\u0435\u0440\u044C \u043E\u0441\u0442\u0430\u0442\u043A\u0438
    \u043E\u0445\u0440\u0430\u043D\u044F\u044E\u0442 \u0437\u043D\u0430\u0442\u043D\u044B\u0435
    \u0440\u043E\u0434\u044B. "
  - "\u0410 \u044F \u0445\u043E\u0447\u0443 \u0438\u0437\u0431\u0430\u0432\u0438\u0442\u044C\u0441\u044F
    \u043E\u0442 \u043D\u0438\u0445."
  - "\u041B\u044E\u0434\u0438 \u0431\u043E\u044F\u0442\u0441\u044F \u0438\u0445.
    \u0418 \u043D\u0435 \u0445\u043E\u0442\u044F\u0442 \u0441\u0442\u0430\u0442\u044C
    \u043E\u0434\u043D\u0438\u043C\u0438 \u0438\u0437 \u043D\u0438\u0445."
  - "\u042F \u043F\u0440\u043E\u0448\u0443 \u043F\u043E\u0433\u0440\u0443\u0437\u0438\u0442\u044C
    \u0432 \u0441\u043F\u044F\u0447\u043A\u0443 \u0431\u043E\u043B\u044C\u0448\u0443\u044E
    \u0447\u0430\u0441\u0442\u044C \u044D\u0442\u0438\u0445 \u0442\u0432\u0430\u0440\u0435\u0439,
    \u0447\u0442\u043E\u0431\u044B \u043C\u043E\u0438 \u043B\u044E\u0434\u0438 \u0441
    \u0431\u043E\u043B\u044C\u0448\u0438\u043C \u0440\u0432\u0435\u043D\u0438\u0435\u043C
    \u043E\u0445\u0440\u0430\u043D\u044F\u043B\u0438 \u0432\u0430\u0441."
