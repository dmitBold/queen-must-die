  m_Name: R_Aminthor Junior_Letters for guardsmen
  m_EditorClassIdentifier: Assembly-CSharp::CardData
  CardPages:
  - "\u042F \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u0430 \u0432 \u0437\u0430\u043C\u043E\u043A
    \u043F\u0438\u0441\u044C\u043C\u0430 \u0434\u043B\u044F \u0433\u0432\u0430\u0440\u0434\u0435\u0439\u0446\u0435\u0432,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0445\u043E\u0442\u044F\u0442 \u0443\u0439\u0442\u0438
    \u043A \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440\u0443."
  - "\u0422\u0443\u0442 \u043F\u0438\u0441\u044C\u043C\u0430 \u043E\u0442 \u043C\u0430\u0442\u0435\u0440\u0435\u0439.
    \u041C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C, \u043E\u043D\u0438 \u0437\u0430\u0441\u0442\u0430\u0432\u044F\u0442
    \u0441\u044B\u043D\u043E\u0432\u0435\u0439 \u043F\u0435\u0440\u0435\u0434\u0443\u043C\u0430\u0442\u044C."
  - "\u0421\u0440\u0435\u0434\u0438 \u043D\u0438\u0445 \u0438 \u043C\u043E\u0439
    \u0431\u0440\u0430\u0442... \u041C\u043E\u0439 \u043E\u0442\u0435\u0446, \u0413\u0435\u043D\u0435\u0440\u0430\u043B
    \u0413\u0435\u0444\u0435\u0441\u0442\u0438\u043E\u043D, \u0433\u043E\u0440\u0434
    \u0437\u0430 \u043D\u0435\u0433\u043E, \u043D\u043E..."
  - "...\u041D\u043E \u044F \u043D\u0435 \u0441\u043C\u043E\u0433\u0443 \u0431\u0435\u0437
    \u043D\u0435\u0433\u043E. \u0420\u0430\u0437\u0440\u0435\u0448\u0438\u0442\u0435
    \u043F\u0440\u043E\u0439\u0442\u0438 \u0432 \u0437\u0430\u043C\u043E\u043A \u0438
    \u043E\u0442\u0434\u0430\u0442\u044C \u043F\u0438\u0441\u044C\u043C\u0430."
