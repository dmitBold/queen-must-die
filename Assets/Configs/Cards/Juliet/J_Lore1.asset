  CardText: "\u0418\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u043E \u043D\u0435
    \u0437\u043D\u0430\u0435\u0442 \u0433\u0440\u0430\u043D\u0438\u0446 \u0438 \u0444\u043E\u0440\u043C
    \u0447\u0435\u0440\u0435\u043F\u0430! \u042F \u0445\u043E\u0447\u0443 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043E\u0432\u0430\u0442\u044C
    \u0413\u0440\u0430\u043D\u0434-\u0412\u044B\u0441\u0442\u0430\u0432\u043A\u0443.
    \u041A\u0430\u0440\u0442\u0438\u043D\u044B \u043B\u044E\u0434\u0435\u0439, \u0441\u043A\u0443\u043B\u044C\u043F\u0442\u0443\u0440\u044B
    \u0437\u043C\u0435\u0439, \u043F\u0430\u0443\u0447\u044C\u044F \u0432\u044F\u0437\u044C!
    \u041D\u0443\u0436\u043D\u043E \u043B\u0438\u0448\u044C \u043D\u0435\u043C\u043D\u043E\u0433\u043E
    \u0437\u043E\u043B\u043E\u0442\u0430 \u0438\u0437 \u043A\u0430\u0437\u043D\u044B
    \u043D\u0430 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u044E."
