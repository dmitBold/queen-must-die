--- !u!114 &-6106122749231249231
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5bfaef14aad5c6d4290db6ba8649565b, type: 3}
  m_Name: DialogueClip
  m_EditorClassIdentifier: Assembly-CSharp::DialogueClip
  dialoguePages:
  - "\u041D\u0435 \u0431\u043E\u0439\u0441\u044F. \u042F - \u0442\u0432\u043E\u0439
    \u043E\u0442\u0435\u0446. \u0412\u044B \u0434\u0443\u043C\u0430\u0435\u0442\u0435,
    \u0447\u0442\u043E \u044F \u0443\u043C\u0435\u0440 \u0441\u0432\u043E\u0435\u0439
    \u0441\u043C\u0435\u0440\u0442\u044C\u044E, \u043D\u043E \u044D\u0442\u043E \u043D\u0435
    \u0442\u0430\u043A."
  - "\u0427\u0442\u043E-\u0442\u043E \u0442\u0430\u0438\u0442\u0441\u044F \u0432
    \u044D\u0442\u043E\u043C \u0437\u0430\u043C\u043A\u0435. \u0418\u043C\u0435\u043D\u043D\u043E
    \u043E\u043D\u043E \u043F\u0440\u0438\u0432\u0435\u043B\u043E \u043C\u0435\u043D\u044F
    \u043A \u0433\u0438\u0431\u0435\u043B\u0438, \u0430 \u0442\u0435\u043F\u0435\u0440\u044C
    \u0438 \u0442\u0435\u0431\u044F \u0436\u0434\u0435\u0442 \u0442\u0430 \u0436\u0435
    \u0443\u0447\u0430\u0441\u0442\u044C, \u0435\u0441\u043B\u0438 \u0442\u044B \u043D\u0435
    \u0431\u0443\u0434\u0435\u0448\u044C \u0431\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u0430."
  - "\u0418\u0449\u0438 \u043F\u0440\u0435\u0434\u0430\u0442\u0435\u043B\u0435\u0439.
    \u0421\u043B\u0435\u0434\u0438 \u0437\u0430 \u0432\u0441\u0435\u043C \u0432\u043E\u043A\u0440\u0443\u0433
    \u0441\u0435\u0431\u044F. \u041D\u0430\u0439\u0434\u0438 \u0443\u0433\u0440\u043E\u0437\u0443
    \u0438\u043B\u0438 \u043F\u043E\u0433\u0438\u0431\u043D\u0438"
  pauseTimeline: 0
