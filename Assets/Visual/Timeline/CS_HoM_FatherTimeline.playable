  m_Script: {fileID: 11500000, guid: 5bfaef14aad5c6d4290db6ba8649565b, type: 3}
  m_Name: DialogueClip(Clone)(Clone)
  m_EditorClassIdentifier: Assembly-CSharp::DialogueClip
  dialoguePages:
  - "\u042F \u043D\u0430\u043A\u043E\u043D\u0435\u0446 \u043D\u0430\u0448\u0435\u043B
    \u0442\u0435\u0431\u044F. \u0412\u0441\u0442\u0430\u043D\u044C, \u0438\u0431\u043E
    \u043F\u0435\u0440\u0435\u0434 \u0442\u043E\u0431\u043E\u0439 \u041A\u043E\u0440\u043E\u043B\u044C
    \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u041F\u0435\u0440\u0432\u044B\u0439
    \u041E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u0442\u0435\u043B\u044C!"
  - "\u041F\u0435\u0440\u0435\u0434 \u0442\u043E\u0431\u043E\u0439 \u0442\u0432\u043E\u0439
    \u043E\u0442\u0435\u0446."
  - "\u041F\u043E\u0440\u0430 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F
    \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u043E\u0439, \u0434\u043E\u0447\u044C
    \u043C\u043E\u044F."
  pauseTimeline: 1
