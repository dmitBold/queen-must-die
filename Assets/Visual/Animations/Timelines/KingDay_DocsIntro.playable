  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5bfaef14aad5c6d4290db6ba8649565b, type: 3}
  m_Name: DialogueClip
  m_EditorClassIdentifier: Assembly-CSharp::NightCycle.DialogueClip
  dialoguePages:
  - "\u041F\u0440\u043E\u0441\u0442\u0438 \u0437\u0430 \u043E\u043F\u043E\u0437\u0434\u0430\u043D\u0438\u0435,
    \u043E\u0442\u0435\u0446. \u041C\u043D\u0435 \u0442\u0440\u0443\u0434\u043D\u043E
    \u0443\u0441\u043B\u0435\u0434\u0438\u0442\u044C \u0437\u0430 \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C
    \u0437\u0434\u0435\u0441\u044C."
  - "\u0422\u044B \u0443\u0436\u0435 \u043C\u0435\u0441\u044F\u0446 \u0437\u0434\u0435\u0441\u044C.
    \u041C\u043E\u0436\u043D\u043E \u0431\u044B\u043B\u043E \u043F\u0440\u0438\u0432\u044B\u043A\u043D\u0443\u0442\u044C,
    \u0447\u0442\u043E \u0437\u0434\u0435\u0441\u044C \u043D\u0435\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u0438."
  - "\u041D\u0435\u0442... \u0432\u0440\u0435\u043C\u0435\u043D\u0438?"
  - "\u041F\u0435\u0440\u0435\u0439\u0434\u0451\u043C \u043A \u0434\u0435\u043B\u0443.
    \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0442\u044B \u043F\u0440\u0438\u043C\u0435\u0448\u044C
    \u0441\u0432\u043E\u0438 \u043F\u0435\u0440\u0432\u044B\u0435 \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u044B\u0435
    \u0440\u0435\u0448\u0435\u043D\u0438\u044F."
  - "\u041E\u043D\u0438 \u043A\u0430\u0441\u0430\u044E\u0442\u0441\u044F \u0440\u0430\u0441\u043A\u043E\u043F\u043E\u043A,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u0440\u043E\u0432\u043E\u0434\u044F\u0442
    \u043F\u043E\u0434 \u0437\u0430\u043C\u043A\u043E\u043C."
  dialogueNames:
  - "\u041F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0430 \u0411\u0435\u0442"
  - "\u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u0410\u0440\u0433\u0435\u0430\u0434"
  - "\u041F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0430 \u0411\u0435\u0442"
  - "\u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u0410\u0440\u0433\u0435\u0430\u0434"
  - "\u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u0410\u0440\u0433\u0435\u0430\u0434"
  pauseTimeline: 1
