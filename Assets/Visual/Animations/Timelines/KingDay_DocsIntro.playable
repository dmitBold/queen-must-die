  m_Name: DialogueClip
  m_EditorClassIdentifier: Assembly-CSharp::NightCycle.DialogueClip
  dialoguePages:
  - "\u0421\u043B\u0435\u0434\u0438 \u0437\u0430 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u043E\u0439
    \u0432\u0441\u0435\u0445 \u043D\u0430\u0440\u043E\u0434\u043E\u0432."
  - "\u041D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u0430\u044F
    \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0430 \u043F\u0440\u0438\u0432\u0435\u0434\u0451\u0442
    \u043A \u043D\u0430\u0447\u0430\u043B\u0443 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0438\u044F."
  - "\u0415\u0441\u043B\u0438 \u0442\u044B \u043D\u0435 \u043F\u043E\u0434\u0430\u0432\u0438\u0448\u044C
    \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0438\u0435 \u043C\u0438\u0440\u043D\u044B\u043C
    \u0438\u043B\u0438 \u0432\u043E\u0435\u043D\u043D\u044B\u043C \u043F\u0443\u0442\u0451\u043C,"
  - "\u0442\u043E \u043E\u0434\u0438\u043D \u0438\u0437 \u043D\u0430\u0440\u043E\u0434\u043E\u0432
    \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u0442\u0451\u0442 \u043D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u044C."
  - "\u0415\u0441\u043B\u0438 \u0432\u0441\u0435 \u043D\u0430\u0440\u043E\u0434\u044B
    \u0441\u0442\u0430\u043D\u0443\u0442 \u043D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u044B\u043C\u0438,
    \u0442\u043E \u043E\u0442 \u0438\u043C\u043F\u0435\u0440\u0438\u0438 \u043D\u0438\u0447\u0435\u0433\u043E
    \u043D\u0435 \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F."
  dialogueNames:
  - "\u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u0410\u0440\u0433\u0435\u0430\u0434"
  - "\u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u0410\u0440\u0433\u0435\u0430\u0434"
