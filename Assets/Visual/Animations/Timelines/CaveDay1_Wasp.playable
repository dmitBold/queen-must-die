--- !u!114 &-4288325073683600243
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5bfaef14aad5c6d4290db6ba8649565b, type: 3}
  m_Name: DialogueClip
  m_EditorClassIdentifier: Assembly-CSharp::NightCycle.DialogueClip
  dialoguePages:
  - WORK IN PROGRESS
  - "\u0418\u0437 \u0443\u043B\u044C\u044F \u0432\u044B\u043B\u0435\u0437\u0430\u0435\u0442
    \u0433\u0438\u0433\u0430\u043D\u0442\u0441\u043A\u0430\u044F \u043E\u0441\u0430."
  - "\u0422\u044B. \u041D\u0435. \u0410\u0432\u0433\u0443\u0441\u0442."
  - "\u042F... \u042F \u0437-\u0437\u043D\u0430\u044E \u0410-\u0430\u0432\u0433\u0443\u0441\u0442\u0430."
  - "\u0414\u0435\u0432\u043E\u0447\u043A\u0430. \u0423\u0433\u0440\u043E\u0437\u0430.
    \u041E\u043D \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F
    \u0442\u043E\u0431\u043E\u0439."
  - "\u0422\u044B \u0438\u043C\u0435\u0435\u0448\u044C \u0432 \u0432\u0438\u0434\u0443
    \u0410\u0432\u0433\u0443\u0441\u0442\u0430? \u041D\u043E \u0437\u0430\u0447\u0435\u043C
    \u0435\u043C\u0443 \u0431\u044B\u043B\u043E \u044D\u0442\u043E?"
  - "\u041D\u0435 \u0410\u0432\u0433\u0443\u0441\u0442... \u0421\u043B\u043E\u0436\u043D\u043E
    \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C. \u041D\u0435 \u043C\u043E\u0451
    \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435."
  - "\u0423\u0433\u0440\u043E\u0437\u0430 \u043D\u0435 \u043E\u0442 \u0410\u0432\u0433\u0443\u0441\u0442\u0430?
    \u041E\u0442 \u043A\u043E\u0433\u043E? \u042D\u0442\u043E \u043E\u0442 \u043D\u0435\u0433\u043E
    \u043C\u0435\u043D\u044F \u043F\u0440\u044F\u0442\u0430\u043B\u0438?"
  - "\u041E\u0441\u0430 \u0432\u043E\u0441\u043F\u043B\u0430\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F.
    \u0411\u0435\u0442 \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F."
  - "\u0417\u0430 \u0435\u0451 \u0441\u043F\u0438\u043D\u043E\u0439 \u0441\u0442\u043E\u0438\u0442
    \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440. \u041E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442
    \u043D\u0430 \u043E\u0441\u0443."
  - "\u0417\u043D\u0430\u0447\u0438\u0442, \u0435\u0433\u043E \u0440\u0443\u043A\u0438
    \u0434\u043E\u0448\u043B\u0438 \u0438 \u0434\u043E \u0432\u0430\u0441. \u041B\u0430\u0434\u043D\u043E,
    \u044F \u0440\u0430\u0437\u0431\u0435\u0440\u0443\u0441\u044C \u0441 \u043D\u0438\u043C.
    \u0411\u0435\u0442, \u0443\u0431\u0435\u0439 \u0435\u0451."
  - "\u041D\u043E \u044F \u0436\u0435... \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u0442\u044C\u0441\u044F...
    \u0437\u0430\u0449\u0438\u0442\u0430."
  - "\u041C\u043E\u043B\u043E\u0434\u0435\u0446. \u041D\u0430 \u0442\u0432\u043E\u0451
    \u043C\u0435\u0441\u0442\u043E \u043F\u0440\u0438\u0434\u0443\u0442 \u0434\u0440\u0443\u0433\u0438\u0435."
  - "\u041E\u0441\u0430 \u0441\u0433\u043E\u0440\u0430\u0435\u0442 \u0432 \u043C\u0443\u043A\u0430\u0445."
  - "\u0422\u044B \u043C\u043E\u043B\u043E\u0434\u0435\u0446, \u0434\u0435\u0432\u043E\u0447\u043A\u0430.
    \u0412\u044B\u0436\u0438\u0442\u044C \u0432 \u044D\u0442\u043E\u043C \u043C\u0435\u0441\u0442\u0435
    \u2014 \u044D\u0442\u043E \u0434\u043E\u0441\u0442\u043E\u0439\u043D\u043E."
  - "\u0423 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C \u0434\u043B\u044F
    \u0442\u0435\u0431\u044F \u043D\u0430\u0433\u0440\u0430\u0434\u0430. \u0417\u0430\u0432\u0442\u0440\u0430
    \u0442\u044B \u0431\u0443\u0434\u0435\u0448\u044C \u043F\u0440\u0430\u0432\u0438\u0442\u044C
    \u043E\u0442 \u043C\u043E\u0435\u0433\u043E \u043B\u0438\u0446\u0430."
  - "\u0423 \u043C\u0435\u043D\u044F \u043F\u043E\u044F\u0432\u0438\u043B\u0438\u0441\u044C
    \u0434\u0440\u0443\u0433\u0438\u0435 \u0434\u0435\u043B\u0430."
  - "\u042D\u0442\u043E... \u0441\u0432\u044F\u0437\u0430\u043D\u043E \u0441 \u0410\u0432\u0433\u0443\u0441\u0442\u043E\u043C?"
  - "\u041D\u0435\u0442. \u0418\u0434\u0438 \u0441\u043F\u0430\u0442\u044C, \u0411\u0435\u0442.
    \u0417\u0430\u0432\u0442\u0440\u0430 \u0443 \u0442\u0435\u0431\u044F \u0432\u0430\u0436\u043D\u044B\u0439
    \u0434\u0435\u043D\u044C."
  dialogueNames:
  - ' '
  - "\u041E\u043F\u0438\u0441\u0430\u043D\u0438\u0435"
  - "\u041E\u0441\u0430"
  - "\u041F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0430 \u0411\u0435\u0442"
  - "\u041E\u0441\u0430"
  - "\u041F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0430 \u0411\u0435\u0442"
  - "\u041E\u0441\u0430"
  - "\u041F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0430 \u0411\u0435\u0442"
  - "\u041E\u043F\u0438\u0441\u0430\u043D\u0438\u0435"
  - "\u041E\u043F\u0438\u0441\u0430\u043D\u0438\u0435"
  - "\u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u0410\u0440\u0433\u0435\u0430\u0434"
  - "\u041E\u0441\u0430"
  - "\u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u0410\u0440\u0433\u0435\u0430\u0434"
  - "\u041E\u043F\u0438\u0441\u0430\u043D\u0438\u0435"
  - "\u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u0410\u0440\u0433\u0435\u0430\u0434"
  - "\u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u0410\u0440\u0433\u0435\u0430\u0434"
  - "\u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u0410\u0440\u0433\u0435\u0430\u0434"
  - "\u041F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0430 \u0411\u0435\u0442"
  - "\u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u0410\u0440\u0433\u0435\u0430\u0434"
  pauseTimeline: 1
