  m_Script: {fileID: 11500000, guid: 5bfaef14aad5c6d4290db6ba8649565b, type: 3}
  m_Name: DialogueClip(Clone)(Clone)
  m_EditorClassIdentifier: Assembly-CSharp::NightCycle.DialogueClip
  dialoguePages:
  - "\u0423\u0431\u0435\u0439 \u0435\u0433\u043E.\r\n"
  - "\u041E\u043D \u043D\u0430\u0437\u0432\u0430\u043B \u0442\u0435\u0431\u044F \u0431\u0430\u0441\u0442\u0430\u0440\u0434\u043E\u043C.
    \u041E\u043D \u043E\u0441\u043A\u043E\u0440\u0431\u0438\u043B \u0442\u0435\u0431\u044F.
    \u0417\u043D\u0430\u0447\u0438\u0442 \u043E\u043D \u0434\u043E\u043B\u0436\u0435\u043D
    \u0443\u043C\u0435\u0440\u0435\u0442\u044C."
  - "\u042F... \u042F \u043D\u0435 \u0445\u043E\u0447\u0443."
  - "\u042F \u043D\u0435 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u043B \u0445\u043E\u0447\u0435\u0448\u044C
    \u0442\u044B \u0438\u043B\u0438 \u043D\u0435\u0442. \u0414\u0435\u043B\u0430\u0439
    \u0447\u0442\u043E \u0442\u0435\u0431\u0435 \u0432\u0435\u043B\u0438\u0442 \u043E\u0442\u0435\u0446
    \u0438 \u043A\u043E\u0440\u043E\u043B\u044C."
  dialogueNames:
  - "\u041A\u043E\u0440\u043E\u043B\u044C \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440"
