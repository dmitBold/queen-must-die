  m_Name: DialogueClip
  m_EditorClassIdentifier: Assembly-CSharp::NightCycle.DialogueClip
  dialoguePages:
  - "\u0422\u0435\u0431\u0435 \u043F\u0440\u0435\u0434\u0441\u0442\u043E\u0438\u0442
    \u0443\u0431\u0438\u0442\u044C \u043C\u043D\u043E\u0433\u043E \u043D\u0435\u043B\u044E\u0434\u0435\u0439,
    \u0447\u0442\u043E\u0431\u044B \u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0438\u0445
    \u0432 \u0443\u0437\u0434\u0435. \u0427\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0430\u044F
    \u0437\u043D\u0430\u0442\u044C - \u0434\u0440\u0443\u0433\u043E\u0439 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440."
  - "\u0410\u0440\u0433\u0435\u0430\u0434 \u043E\u0431\u044F\u0437\u0430\u043D \u0441\u0430\u043C
    \u0443\u0431\u0438\u0442\u044C \u043F\u0440\u043E\u0432\u0438\u043D\u0438\u0432\u0448\u0435\u0433\u043E\u0441\u044F.
    \u0422\u0430\u043A \u043C\u044B \u0434\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u043C
    \u0441\u0432\u043E\u044E \u0432\u043B\u0430\u0441\u0442\u044C."
  dialogueNames:
  - "\u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u0410\u0440\u0433\u0435\u0430\u0434"
  - "\u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u0410\u0440\u0433\u0435\u0430\u0434"
  pauseTimeline: 1
