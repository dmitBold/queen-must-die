  m_Name: DialogueClip
  m_EditorClassIdentifier: Assembly-CSharp::NightCycle.DialogueClip
  dialoguePages:
  - WORK IN PROGRESS
  - "\u0411\u0435\u0442 \u0440\u0435\u0437\u043A\u043E \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
    \u0433\u043E\u043B\u043E\u0432\u0443. \u041E\u043D\u0430 \u0437\u0430\u0441\u043D\u0443\u043B\u0430
    \u0437\u0430 \u0443\u0447\u0435\u0431\u043D\u044B\u043C \u0441\u0442\u043E\u043B\u043E\u043C."
  - "\u0422\u043E, \u0447\u0442\u043E \u043E\u043D\u0430 \u0432\u0438\u0434\u0435\u043B\u0430,
    \u0431\u044B\u043B\u043E \u043A\u043E\u0448\u043C\u0430\u0440\u043E\u043C."
  - "\u041E\u043F\u044F\u0442\u044C \u0437\u0434\u0435\u0441\u044C \u0443\u0441\u043D\u0443\u043B\u0430..."
  - "\u0423\u0436\u0435 \u0434\u0435\u043D\u044C. \u042F \u0432\u0435\u0434\u044C
    \u0434\u043E\u043B\u0436\u043D\u0430 \u0431\u044B\u043B\u0430 \u043F\u0440\u0438\u0439\u0442\u0438
    \u043A \u043E\u0442\u0446\u0443 \u0441 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u043E\u043C!"
  dialogueNames:
  - ' '
  - "\u041E\u043F\u0438\u0441\u0430\u043D\u0438\u0435"
  - "\u041E\u043F\u0438\u0441\u0430\u043D\u0438\u0435"
  - "\u041F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0430 \u0411\u0435\u0442"
  - "\u041F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0430 \u0411\u0435\u0442"
  pauseTimeline: 1
