--- !u!114 &6680141120437241608
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5bfaef14aad5c6d4290db6ba8649565b, type: 3}
  m_Name: DialogueClip
  m_EditorClassIdentifier: Assembly-CSharp::NightCycle.DialogueClip
  dialoguePages:
  - "\u0417\u0434\u0435\u0441\u044C \u043D\u0435\u0442 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u0430
    \u043D\u0435 \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C \u043D\u0435\u043B\u044E\u0434\u0435\u0439
    \u043D\u0430 \u0441\u043C\u0435\u0440\u0442\u044C."
  - "\u041A\u043E\u0433\u043E \u0436\u0435 \u043C\u043D\u0435 \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C?
    \u041B\u044E\u0434\u0435\u0439? \u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u0442\u0441\u044F."
  - "\u041D\u043E... \u0412\u044B \u0436\u0435 \u043A\u043E\u0440\u043E\u043B\u044C.
    \u041E\u043D\u0438 \u0432\u0430\u0441 \u043F\u043E\u0441\u043B\u0443\u0448\u0430\u044E\u0442."
  - "\u042F \u043A\u043E\u0440\u043E\u043B\u044C \u043B\u044E\u0434\u0435\u0439,
    \u0430 \u043D\u0435 \u0438\u0445 \u0441\u043B\u0443\u0433. \u041E\u0447\u0435\u0432\u0438\u0434\u043D\u043E,
    \u0447\u044C\u044E \u0436\u0438\u0437\u043D\u044C \u044F \u0431\u0443\u0434\u0443
    \u0446\u0435\u043D\u0438\u0442\u044C."
  - "\u041F\u0440\u0438 \u043C\u043E\u0451\u043C \u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438
    \u0442\u0430\u043A\u043E\u0433\u043E \u043D\u0435 \u0431\u0443\u0434\u0435\u0442."
  - "\u0417\u043D\u0430\u0447\u0438\u0442, \u0442\u0432\u043E\u0438 \u043F\u043E\u0434\u0434\u0430\u043D\u043D\u044B\u0435
    \u0432\u043E\u0440\u0432\u0443\u0442\u0441\u044F \u0432 \u0437\u0430\u043C\u043E\u043A
    \u0438 \u0441\u043E\u0436\u0433\u0443\u0442 \u0442\u0435\u0431\u044F \u0437\u0430\u0436\u0438\u0432\u043E."
  - "\u041F\u043E\u043A\u0430 \u0442\u044B \u0431\u0443\u0434\u0435\u0448\u044C \u0432\u0438\u0437\u0436\u0430\u0442\u044C
    \u043E\u0442 \u0431\u043E\u043B\u0438, \u043E\u043D\u0438 \u0443\u0436\u0435
    \u0431\u0443\u0434\u0443\u0442 \u0432\u044B\u0431\u0438\u0440\u0430\u0442\u044C
    \u0442\u0435\u0431\u0435 \u0437\u0430\u043C\u0435\u043D\u0443."
  - "\u0422\u0430\u043A \u043D\u0430\u0448 \u0440\u043E\u0434 \u0438 \u043F\u0440\u0438\u0448\u0451\u043B
    \u043A \u0432\u043B\u0430\u0441\u0442\u0438 \u043F\u043E\u0441\u043B\u0435 \u0441\u0435\u043D\u0430\u0442\u0430."
  - "\u042D\u0442\u043E \u0431\u044B\u043B\u043E \u0434\u0430\u043B\u0435\u043A\u043E
    \u0432 \u043F\u0440\u043E\u0448\u043B\u043E\u043C."
  - "\u0423\u0431\u0438\u0440\u0430\u0439\u0441\u044F \u043E\u0442\u0441\u044E\u0434\u0430,"
  - "\u0438 \u0447\u0442\u043E\u0431\u044B \u043D\u0438 \u044F, \u043D\u0438 \u043A\u0442\u043E-\u043B\u0438\u0431\u043E
    \u043D\u0430 \u043A\u043E\u043D\u0442\u0438\u043D\u0435\u043D\u0442\u0435 \u043D\u0435
    \u0441\u043B\u044B\u0448\u0430\u043B \u043E\u0442 \u0442\u0435\u0431\u044F \u0441\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u044F
    \u043A \u043D\u0435\u043B\u044E\u0434\u044F\u043C."
  dialogueNames:
  - "\u041F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0430 \u0411\u0435\u0442"
  - "\u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u0410\u0440\u0433\u0435\u0430\u0434"
  - "\u041F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0430 \u0411\u0435\u0442"
  - "\u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u0410\u0440\u0433\u0435\u0430\u0434"
  - "\u041F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0430 \u0411\u0435\u0442"
  - "\u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u0410\u0440\u0433\u0435\u0430\u0434"
  - "\u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u0410\u0440\u0433\u0435\u0430\u0434"
  - "\u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u0410\u0440\u0433\u0435\u0430\u0434"
  - "\u041F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0430 \u0411\u0435\u0442"
  - "\u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u0410\u0440\u0433\u0435\u0430\u0434"
  - "\u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u0410\u0440\u0433\u0435\u0430\u0434"
  pauseTimeline: 1
