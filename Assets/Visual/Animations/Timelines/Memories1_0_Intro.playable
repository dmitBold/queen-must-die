--- !u!114 &6461360030497661565
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5bfaef14aad5c6d4290db6ba8649565b, type: 3}
  m_Name: DialogueClip
  m_EditorClassIdentifier: Assembly-CSharp::NightCycle.DialogueClip
  dialoguePages:
  - "\u0414\u0430\u043D\u043D\u0430\u044F \u0447\u0430\u0441\u0442\u044C \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
    \u0438\u0437 \u0441\u0435\u0431\u044F \u043E\u0431\u0440\u0435\u0437\u043E\u043A
    \u0437\u0430\u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E
    \u0443\u0440\u043E\u0432\u043D\u044F. \u041E\u043D \u043D\u0443\u0436\u0435\u043D
    \u0434\u043B\u044F \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u044F \u0437\u0430\u0432\u044F\u0437\u043A\u0438
    \u0441\u044E\u0436\u0435\u0442\u0430."
  - "\u0410\u0432\u0433\u0443\u0441\u0442... \u041E\u043D \u0432\u0440\u0430\u043B
    \u043C\u043D\u0435..."
  - "\u042D\u0442\u043E\u0442 \u0440\u044B\u0446\u0430\u0440\u044C - \u043C\u043E\u0439
    \u043A\u043E\u0440\u043E\u043B\u044C. \u041C\u043E\u0439 \u043E\u0442\u0435\u0446!"
  - "\u042F \u043C\u043E\u0433\u043B\u0430 \u0436\u0438\u0442\u044C \u0432 \u0437\u0430\u043C\u043A\u0435,
    \u043C\u043E\u0433\u043B\u0430 \u0434\u0435\u043B\u0430\u0442\u044C \u0432\u0441\u0451,
    \u0447\u0442\u043E \u0437\u0430\u0445\u043E\u0447\u0443. \u041D\u043E \u043C\u0435\u043D\u044F
    \u0434\u0435\u0440\u0436\u0430\u043B\u0438 \u0432\u0437\u0430\u043F\u0435\u0440\u0442\u0438."
  - "\u041D\u0443 \u0438 \u043F\u0443\u0441\u0442\u044C. \u0422\u0435\u043F\u0435\u0440\u044C
    \u044F \u043F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0430. \u041F\u0440\u0438
    \u0434\u0432\u043E\u0440\u0435 \u0448\u0435\u043F\u0447\u0443\u0442\u0441\u044F,
    \u0447\u0442\u043E \u044F \u0431\u0430\u0441\u0442\u0430\u0440\u0434. \u041D\u0443
    \u0438 \u043F\u0443\u0441\u0442\u044C."
  - "\u041D\u0430\u043A\u043E\u043D\u0435\u0446-\u0442\u043E \u043C\u043E\u044F \u0436\u0438\u0437\u043D\u044C
    \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u0442\u0435\u0442 \u0445\u043E\u0442\u044C
    \u043A\u0430\u043A\u0438\u0435-\u0442\u043E \u043A\u0440\u0430\u0441\u043A\u0438."
  dialogueNames:
  - '[WORK IN PROGRESS]'
  - "\u0411\u0435\u0442"
  - "\u0411\u0435\u0442"
  - "\u0411\u0435\u0442"
  - "\u0411\u0435\u0442"
  - "\u0411\u0435\u0442"
  pauseTimeline: 1
