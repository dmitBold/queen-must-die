  m_Name: DialogueClip(Clone)(Clone)
  m_EditorClassIdentifier: Assembly-CSharp::NightCycle.DialogueClip
  dialoguePages:
  - "\u041D\u0430\u0448\u0430 \u0438\u043C\u043F\u0435\u0440\u0438\u044F \u043D\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u0430
    \u0447\u0443\u0434\u043E\u0432\u0438\u0449\u0430\u043C\u0438 \u0432\u043D\u0435\u0448\u043D\u0438\u043C\u0438
    \u0438 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u043C\u0438."
  - "\u041F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u043B\u0435\u0442
    \u0442\u0435\u0431\u044F \u0441\u043A\u0440\u044B\u0432\u0430\u043B\u0438 \u043E\u0442
    \u043C\u0435\u043D\u044F. \u041F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C
    \u043B\u0435\u0442 \u0442\u044B \u043C\u043E\u0433\u043B\u0430 \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0442\u044C
    \u0438 \u0443\u0447\u0438\u0442\u044C\u0441\u044F."
  - "\u0422\u0435\u043F\u0435\u0440\u044C \u0442\u0435\u0431\u0435 \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F
    \u0443\u0442\u0440\u043E\u0435\u043D\u043D\u044B\u043C\u0438 \u0443\u0441\u0438\u043B\u0438\u044F\u043C\u0438
    \u043D\u0430\u0432\u0435\u0440\u0441\u0442\u044B\u0432\u0430\u0442\u044C \u0443\u043F\u0443\u0449\u0435\u043D\u043D\u043E\u0435."
  pauseTimeline: 1
