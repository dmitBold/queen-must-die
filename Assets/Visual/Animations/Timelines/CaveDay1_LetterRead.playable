  m_Name: DialogueClip
  m_EditorClassIdentifier: Assembly-CSharp::NightCycle.DialogueClip
  dialoguePages:
  - "\u041C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C, \u044D\u0442\u043E
    \u043D\u0435 \u043C\u043E\u0439 \u0410\u0432\u0433\u0443\u0441\u0442..."
  - "\u0415\u0441\u043B\u0438 \u0435\u0441\u0442\u044C \u0445\u043E\u0442\u044C \u043C\u0430\u043B\u0435\u0439\u0448\u0430\u044F
    \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C, \u0447\u0442\u043E
    \u043E\u043D \u0432 \u0437\u0430\u043C\u043A\u0435,"
  - "\u0442\u043E \u044F \u0434\u043E\u043B\u0436\u043D\u0430 \u0443\u0437\u043D\u0430\u0442\u044C
    \u043E\u0442\u0432\u0435\u0442\u044B."
  - "\u0418 \u043A\u0430\u043A \u043F\u0438\u0441\u044C\u043C\u043E \u043C\u043E\u0433\u043B\u043E
    \u043F\u043E\u044F\u0432\u0438\u0442\u044C\u0441\u044F \u0438\u0437-\u043F\u043E\u0434
    \u043A\u0440\u043E\u0432\u0430\u0442\u0438?"
  dialogueNames:
  - "\u041F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0430 \u0411\u0435\u0442"
  - "\u041F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0430 \u0411\u0435\u0442"
