--- !u!114 &658634004
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 658634003}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 17593cab2020f8c43a7063ec459d6989, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NoteInteractable
  noteImage: {fileID: 21300000, guid: a99d56a46c4079a4989e7058665975ee, type: 3}
  noteText:
  - "\u0413\u0435\u0444\u0435\u0441\u0442\u0438\u043E\u043D, \u044F \u043E\u0441\u0442\u0430\u0432\u0438\u043B
    \u043D\u0430 \u0441\u0442\u043E\u043B\u0435 <u>\u0440\u0435\u0430\u0433\u0435\u043D\u0442</u>
    \u0434\u043B\u044F \u043C\u0443\u0442\u0430\u0433\u0435\u043D\u0430. \u0422\u0435\u0431\u0435
    \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F \u0435\u0449\u0451
    \u0434\u0432\u0430 \u0440\u0435\u0430\u0433\u0435\u043D\u0442\u0430, \u0447\u0442\u043E\u0431\u044B
    \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u044C \u0442\u043E, \u043D\u0430\u0434
    \u0447\u0435\u043C \u043C\u044B \u0442\u0430\u043A \u0434\u043E\u043B\u0433\u043E
    \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0438. \u041C\u043E\u0438 <u>\u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438
    \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u044B \u043F\u043E
    \u0432\u0441\u0435\u043C\u0443 \u0437\u0430\u043C\u043A\u0443</u>. "
  - "\u042F \u043E\u0441\u0442\u0430\u0432\u0438\u043B \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438,
    \u043A\u0430\u043A \u043D\u0430\u0439\u0442\u0438 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438
    \u0438 \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u0442\u044C \u043A\u043E\u0434\u044B
    \u043A \u0437\u0430\u043C\u043A\u0430\u043C. \u041D\u0430\u0434\u043E \u0431\u044B\u043B\u043E
    \u0441\u043A\u0430\u0437\u0430\u0442\u044C \u0442\u0435\u0431\u0435, \u043A\u0430\u043A
    \u043A \u043D\u0438\u043C \u043F\u043E\u043F\u0430\u0441\u0442\u044C! \u042F
    \u0441\u043E\u0432\u0441\u0435\u043C \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B
    \u0434\u043E\u0432\u0435\u0440\u044F\u0442\u044C \u043B\u044E\u0434\u044F\u043C."
  - "\u041D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438 \u043C\u043E\u0435\u043C\u0443
    \u043D\u0430\u0441\u043B\u0435\u0434\u043D\u0438\u043A\u0443 \u043E \u0442\u043E\u043C,
    \u0447\u0442\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442.
    \u0420\u0430\u0434\u0438 \u044D\u0442\u043E\u0433\u043E \u043F\u0440\u043E\u0435\u043A\u0442\u0430
    \u043C\u044B \u0443\u0436\u0435 \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u043B\u0438
    \u0434\u0432\u0435 \u0442\u044B\u0441\u044F\u0447\u0438 \u0432\u0437\u0440\u043E\u0441\u043B\u044B\u0445
    \u043F\u0430\u0443\u043A\u043E\u0432 \u0438 \u0441\u043E\u0442\u043D\u044E \u0434\u0435\u0442\u0435\u0439.
    \u041A\u0430\u043A\u0438\u0445 \u0431\u044B \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u0432
    \u043E\u043D \u043D\u0438 \u043F\u0440\u0438\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043B\u0441\u044F,
    \u043E\u043D \u043D\u0430\u0441 \u043D\u0435 \u043F\u043E\u0439\u043C\u0451\u0442."
  trigger_once: 1
  noteEvent:
    m_PersistentCalls:
