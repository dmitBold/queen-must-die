  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NightCycle.NightDialogueInteractable
  dialoguePages:
  - "\u0427\u0442\u043E \u0437\u0434\u0435\u0441\u044C \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F?"
  - "\u0420\u0435\u043B\u0438\u043A\u0432\u0430\u0440\u0438\u0439 \u043A\u043E\u0440\u043E\u043B\u044F,
    \u043C\u043E\u044F \u043F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0430."
  - "\u0413\u043E\u0432\u043E\u0440\u044F\u0442, \u0442\u0430\u043C \u043B\u0435\u0436\u0430\u0442
    \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u044B, \u0434\u0430\u044E\u0449\u0438\u0435
    \u0432\u043B\u0430\u0441\u0442\u044C \u043D\u0430\u0434 \u0432\u0441\u0435\u043C
    \u0437\u0430\u043F\u0430\u0434\u043E\u043C."
  - "\u041E\u043D \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 \u043A\u0430\u043A\u0443\u044E-\u0442\u043E \u043A\u043D\u043E\u043F\u043A\u0443?"
  - "\u0412\u0441\u0435, \u043A\u0442\u043E \u0437\u043D\u0430\u043B\u0438 \u044D\u0442\u043E,
    \u0434\u0430\u0432\u043D\u043E \u043C\u0435\u0440\u0442\u0432\u044B. \u041A\u0440\u043E\u043C\u0435
    \u043A\u043E\u0440\u043E\u043B\u044F, \u043A\u043E\u043D\u0435\u0447\u043D\u043E."
  dialogueNames:
  - "\u041F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0430 \u0411\u0435\u0442"
  - "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A"
