--- !u!114 &1993807102
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1993807101}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 17593cab2020f8c43a7063ec459d6989, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NightCycle.NoteInteractable
  noteImage: {fileID: 21300000, guid: a99d56a46c4079a4989e7058665975ee, type: 3}
  noteText:
  - "\u041F\u0435\u0440\u0432\u0430\u044F \u043D\u0435\u0434\u0435\u043B\u044F \u0436\u0438\u0437\u043D\u0438
    \u0411\u0435\u0442 \u0410\u0440\u0433\u0435\u0430\u0434. \u0421\u0442\u0440\u0430\u043D\u043D\u043E\u0435
    \u0447\u0443\u0432\u0441\u0442\u0432\u043E \u2014 \u0438\u043C\u0435\u0442\u044C
    \u0444\u0430\u043C\u0438\u043B\u0438\u044E. \u0414\u0440\u0443\u0433\u0438\u0435
    \u043D\u0430 \u043C\u043E\u0451\u043C \u043C\u0435\u0441\u0442\u0435 \u0434\u0443\u043C\u0430\u043B\u0438
    \u0431\u044B \u043E \u0442\u0430\u043A\u043E\u043C \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E\u043C
    \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0438 \u2014 \u0441\u0442\u0430\u0442\u044C
    \u043F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u043E\u0439! \u041D\u043E \u044D\u0442\u043E
    \u043A\u0430\u0436\u0435\u0442\u0441\u044F \u0442\u0430\u043A\u0438\u043C \u043D\u0435\u0432\u0430\u0436\u043D\u044B\u043C.
    \u041F\u043E\u0441\u043B\u0435 \u0436\u0438\u0437\u043D\u0438 \u043F\u043E\u0434
    \u043F\u0440\u0438\u0441\u043C\u043E\u0442\u0440\u043E\u043C \u0410\u0432\u0433\u0443\u0441\u0442\u0430
    \u044F \u043D\u0430\u043A\u043E\u043D\u0435\u0446 \u0441\u0442\u0430\u043B\u0430
    \u0445\u043E\u0442\u044C \u043A\u0435\u043C-\u0442\u043E."
  - "\u041D\u0435\u0434\u0435\u043B\u044F \u0432\u0442\u043E\u0440\u0430\u044F. \u042F
    \u043E\u0431\u0449\u0430\u044E\u0441\u044C \u0441 \u043E\u0442\u0446\u043E\u043C,
    \u0442\u043E\u043B\u044C\u043A\u043E \u043A\u043E\u0433\u0434\u0430 \u043E\u043D
    \u0437\u043E\u0432\u0451\u0442 \u043C\u0435\u043D\u044F \u0434\u043B\u044F \u0443\u0447\u0451\u0431\u044B.
    \u0415\u0441\u043B\u0438 \u0410\u0432\u0433\u0443\u0441\u0442 \u0432\u0435\u0447\u043D\u043E
    \u0437\u0430\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u043B \u043C\u0435\u043D\u044F
    \u0432\u043E\u043F\u0440\u043E\u0441\u0430\u043C\u0438, \u0442\u043E \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440
    \u0441\u043A\u043E\u0440\u0435\u0435 \u0434\u0430\u0451\u0442 \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438."
  - "\u041D\u0435\u0434\u0435\u043B\u044F \u0442\u0440\u0435\u0442\u044C\u044F. \u0418\u043D\u043E\u0433\u0434\u0430
    \u043E\u0442\u0435\u0446 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
    \u043C\u0435\u043D\u044F \u0441\u0432\u043E\u0438\u043C \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0451\u043D\u043D\u044B\u043C.
    \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043F\u0440\u043E\u0448\u0451\u043B
    \u0431\u0430\u043B \u0432 \u0447\u0435\u0441\u0442\u044C \u043F\u0440\u0438\u0437\u043D\u0430\u043D\u0438\u044F
    \u043C\u0435\u043D\u044F \u0437\u0430\u043A\u043E\u043D\u043D\u043E\u0439 \u043D\u0430\u0441\u043B\u0435\u0434\u043D\u0438\u0446\u0435\u0439.
    \u042F \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0430 \u0441\u0435\u0431\u044F
    \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E \u0434\u0430\u043B\u0451\u043A\u043E\u0439
    \u043E\u0442 \u0432\u0441\u0435\u0445 \u0432\u043E\u043A\u0440\u0443\u0433 \u0438
    \u0432 \u0442\u043E \u0436\u0435 \u0432\u0440\u0435\u043C\u044F \u2014 \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u043C
    \u043F\u0440\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F."
  - "\u0415\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439, \u0441
    \u043A\u0435\u043C \u044F \u0441\u043C\u043E\u0433\u043B\u0430 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C,
    \u2014 \u044D\u0442\u043E \u043E\u0434\u0438\u043D \u0438\u0437 \u0441\u0442\u0440\u0430\u0436\u0435\u0439.
    \u0415\u0433\u043E \u0437\u043E\u0432\u0443\u0442 \u0420\u043E\u043C. \u041E\u043D
    \u0438\u0437 \u0437\u043D\u0430\u0442\u043D\u043E\u0433\u043E \u0440\u043E\u0434\u0430
    \u0410\u043C\u0438\u043D\u0442\u043E\u0440\u043E\u0432. \u0415\u0433\u043E \u043E\u0442\u0435\u0446
    \u2014 \u0433\u0435\u0440\u043E\u0439 \u0432\u043E\u0439\u043D\u044B, \u0433\u0435\u043D\u0435\u0440\u0430\u043B
    \u0438 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0438\u0439 \u0441\u043E\u0440\u0430\u0442\u043D\u0438\u043A
    \u043A\u043E\u0440\u043E\u043B\u044F. \u0415\u043C\u0443 \u0442\u0440\u0443\u0434\u043D\u043E
    \u0443\u0433\u043E\u0434\u0438\u0442\u044C. \u0412\u0441\u043A\u043E\u043B\u044C\u0437\u044C
    \u0420\u043E\u043C \u0443\u043F\u043E\u043C\u044F\u043D\u0443\u043B, \u0447\u0442\u043E
    \u0435\u043C\u0443 \u043D\u0443\u0436\u043D\u0430 \u043F\u043E\u043C\u043E\u0449\u044C.
    <u>\u041D\u0430\u0434\u043E \u0440\u0430\u0441\u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C
    \u0435\u0433\u043E \u043E\u0431 \u044D\u0442\u043E\u043C.</u>"
  trigger_once: 1
  noteEvent:
    m_PersistentCalls:
      m_Calls: []
  interact_sound:
    Guid:
      Data1: -1225164423
      Data2: 1084857888
