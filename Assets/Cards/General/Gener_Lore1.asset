  m_EditorClassIdentifier: Assembly-CSharp::CardData
  CardText: "\u041D\u0430 \u0433\u0440\u0430\u043D\u0438\u0446\u0435 \u043F\u0430\u0443\u043A\u043E\u0432
    \u0438 \u043E\u0441 \u0441\u043D\u043E\u0432\u0430 \u0433\u0440\u0430\u0431\u0435\u0436\u0438.
    \u041D\u0430\u043B\u0435\u0442\u0447\u0438\u043A\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0442
    \u0431\u044B\u0441\u0442\u0440\u043E, \u0441\u043B\u0435\u0434\u043E\u0432 \u043D\u0435
    \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442. \u041D\u0443\u0436\u043D\u043E
    \u043A\u043E\u0433\u043E-\u0442\u043E \u043D\u0430\u043A\u0430\u0437\u0430\u0442\u044C,
    \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C
    \u0441\u0438\u043B\u0443. \u041F\u0440\u0438 \u0432\u0430\u0448\u0435\u043C \u043E\u0442\u0446\u0435
    \u044D\u0442\u043E \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043B\u043E. \u041A\u043E\u0433\u043E
    \u043D\u0430\u0437\u043D\u0430\u0447\u0438\u043C \u0432\u0438\u043D\u043E\u0432\u0430\u0442\u044B\u043C
    \u043D\u0430 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437?"
  LeftChoice:
