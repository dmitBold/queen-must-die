  m_Name: Trade_Pa2
  m_EditorClassIdentifier: Assembly-CSharp::CardData
  CardText: "\u0421\u0435\u043C\u0435\u0439\u0441\u0442\u0432\u043E \u0421\u0435\u043B\u0435\u0432\u043A\u0438\u0434\u043E\u0432
    \u0441\u043A\u0443\u043F\u0438\u043B\u043E \u0432\u0441\u0435 \u0441\u043E\u043B\u044F\u043D\u044B\u0435
    \u043A\u043E\u043F\u0438. \u041C\u043E\u043D\u043E\u043F\u043E\u043B\u0438\u044F!
    \u0417\u0430\u0432\u0442\u0440\u0430 \u043E\u043D\u0438 \u0432\u0437\u0432\u0438\u043D\u0442\u044F\u0442
    \u0446\u0435\u043D\u044B \u0442\u0430\u043A, \u0447\u0442\u043E \u0441\u043E\u043B\u044C
    \u0441\u0442\u0430\u043D\u0435\u0442 \u0434\u043E\u0440\u043E\u0436\u0435 \u0437\u043E\u043B\u043E\u0442\u0430.
    \u041B\u044E\u0434\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442
    \u0441\u043E\u043B\u044C \u0434\u043B\u044F \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F
    \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u043E\u0432, \u044D\u0442\u043E \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u044B\u0439
    \u0434\u043B\u044F \u043D\u0438\u0445 \u0442\u043E\u0432\u0430\u0440. \u0412\u0441\u0435,
    \u043A\u0442\u043E \u043D\u0435 \u0441\u043C\u043E\u0433\u0443\u0442 \u0435\u0433\u043E
    \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u0442\u044C, \u0443\u043C\u0440\u0443\u0442
    \u043E\u0442 \u0433\u043E\u043B\u043E\u0434\u0430."
  LeftChoice:
    text: "\u0412\u044B\u043A\u0443\u043F\u0438\u0442\u044C \u0447\u0430\u0441\u0442\u044C
      \u043A\u043E\u043F\u0435\u0439 "
