  CardText: "\u0423 \u0432\u0430\u0441 \u0432\u0441\u0435 \u043C\u0435\u043D\u044C\u0448\u0435
    \u0437\u043D\u0430\u0442\u043D\u044B\u0445 \u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u043A\u043E\u0432.
    \u0412\u0447\u0435\u0440\u0430 \u043E\u0434\u0438\u043D \u0438\u0437 \u0434\u0435\u0442\u0435\u0439
    \u0431\u044B\u043B, \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u043F\u044C\u044F\u043D.
    \u041E\u043D \u0433\u0440\u043E\u043C\u043A\u043E \u0437\u0430\u044F\u0432\u043B\u044F\u043B,
    \u0447\u0442\u043E \u041A\u043E\u0440\u043E\u043D\u0430 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
    \u0442\u044F\u0436\u0435\u043B\u0430 \u0434\u043B\u044F \u044E\u043D\u043E\u0439
    \u0434\u0435\u0432\u044B \u0438 \u0432\u043B\u0430\u0441\u0442\u044C \u043D\u0443\u0436\u043D\u043E
    \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u044C \u043F\u0430\u0440\u043B\u0430\u043C\u0435\u043D\u0442\u0443.
    \u041C\u043E\u0436\u0435\u0442, \u0432\u0430\u043C \u0438 \u043F\u0440\u0430\u0432\u0434\u0430
    \u0441\u0442\u043E\u0438\u0442 \u043E\u0431\u043B\u0435\u0433\u0447\u0438\u0442\u044C
    \u0431\u0440\u0435\u043C\u044F \u0432\u043B\u0430\u0441\u0442\u0438?"
