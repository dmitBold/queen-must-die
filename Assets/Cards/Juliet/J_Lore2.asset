  m_EditorClassIdentifier: Assembly-CSharp::CardData
  CardText: "\u041C\u043E\u044F \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u0430\u044F
    \u0442\u0440\u0443\u043F\u043F\u0430... \u041E\u043D\u0438 \u0445\u043E\u0442\u0435\u043B\u0438
    \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u043F\u044C\u0435\u0441\u0443
    \u043E \u043C\u0438\u0440\u0435, \u0433\u0434\u0435 \u043D\u0435\u0442 \u0433\u043E\u0441\u043F\u043E\u0434
    \u0438 \u0440\u0430\u0431\u043E\u0432. \u0421\u0435\u0433\u043E\u0434\u043D\u044F
    \u0443\u0442\u0440\u043E\u043C \u0438\u0445 \u043D\u0430\u0448\u043B\u0438 \u0432
    \u043F\u0435\u0440\u0435\u0443\u043B\u043A\u0435. \u0418\u0441\u0442\u0435\u0440\u0437\u0430\u043D\u043D\u044B\u0435
    \u0442\u0435\u043B\u0430 \u043B\u044E\u0434\u0435\u0439 \u0438 \u0437\u043C\u0435\u0439,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0434\u043E\u043B\u0436\u043D\u044B
    \u0431\u044B\u043B\u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0435
    \u0440\u0430\u0441, \u043B\u0435\u0436\u0430\u0442 \u0432 \u043E\u0431\u043D\u0438\u043C\u043A\u0443
    \u0432 \u043B\u0443\u0436\u0430\u0445 \u043A\u0440\u043E\u0432\u0438."
