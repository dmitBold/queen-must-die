  CardText: "\u0412 \u0434\u0435\u0440\u0435\u0432\u043D\u0435 \u043C\u043E\u0435\u0439
    \u0441\u0435\u043C\u044C\u0438 \u043A\u0440\u0435\u0441\u0442\u044C\u044F\u043D\u0435
    \u0441\u0442\u0430\u043B\u0438 \u043F\u043E\u0434\u0440\u0430\u0436\u0430\u0442\u044C
    \u041F\u0430\u0443\u043A\u0430\u043C. \u041E\u043D\u0438 \u043F\u043B\u0435\u0442\u0443\u0442
    \u0443\u0437\u043E\u0440\u044B \u0438\u0437 \u0432\u0435\u0440\u0435\u0432\u043E\u043A
    \u043D\u0430 \u0434\u043E\u043C\u0430\u0445 \u0438 \u0435\u0434\u044F\u0442 \u0441\u0442\u043E\u044F.
    \u041E\u043D\u0438 \u0441\u043F\u044F\u0442 \u0432 \u0447\u0435\u043C-\u0442\u043E
    \u043D\u0430\u043F\u043E\u0434\u043E\u0431\u0438\u0435 \u043A\u043E\u043A\u043E\u043D\u043E\u0432!
    \u042D\u0442\u043E \u043E\u0447\u0435\u043D\u044C \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E,
    \u043D\u043E \u043F\u043E\u0447\u0435\u043C\u0443-\u0442\u043E \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u0435
    \u0434\u0435\u0440\u0435\u0432\u043D\u0438 \u0441\u0442\u0430\u043B\u0438 \u043D\u0430\u043F\u0430\u0434\u0430\u0442\u044C
    \u043D\u0430 \u0431\u0435\u0434\u043E\u043B\u0430\u0433."
  LeftChoice:
