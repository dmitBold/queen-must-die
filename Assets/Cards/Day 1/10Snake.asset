  CardText: "\u041C\u043E\u0439 \u043D\u0430\u0440\u043E\u0434 \u043E\u0447\u0435\u043D\u044C
    \u0446\u0435\u043D\u0438\u0442 \u0441\u0432\u043E\u0438 \u043C\u0430\u0441\u043A\u0438.
    \u0412\u043E \u0432\u0440\u0435\u043C\u044F \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
