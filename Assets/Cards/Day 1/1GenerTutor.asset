  m_Script: {fileID: 11500000, guid: 00c7e4b39926d0b42b78e88af0359330, type: 3}
  m_Name: 1GenerTutor
  m_EditorClassIdentifier: Assembly-CSharp::CardData
  CardText: "\u041D\u0438\u043A\u043E\u0433\u0434\u0430 \u0431\u044B \u043D\u0435
    \u043F\u043E\u0434\u0443\u043C\u0430\u043B, \u0447\u0442\u043E \u043F\u043E\u0441\u043B\u0435
    \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440\u0430 \u041E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u0442\u0435\u043B\u044F
    \u043D\u0430 \u044D\u0442\u043E\u0442 \u0442\u0440\u043E\u043D \u0441\u044F\u0434\u0435\u0442
    \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F \u0434\u0435\u0432\u043E\u0447\u043A\u0430.
    \\n\u0412\u0430\u0448 \u041E\u0442\u0435\u0446 \u043D\u0435 \u0434\u043E\u043B\u0433\u043E
    \u0432\u0430\u0441 \u043E\u0431\u0443\u0447\u0430\u043B. \u041C\u043D\u043E\u0433\u043E\u0435
    \u0432\u0430\u043C \u0435\u0449\u0451 \u043F\u0440\u0435\u0434\u0441\u0442\u043E\u0438\u0442
    \u043F\u043E\u043D\u044F\u0442\u044C \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E
    \u043D\u0430 \u0433\u043E\u0440\u044C\u043A\u043E\u043C \u043E\u043F\u044B\u0442\u0435.
    \\n\u0422\u0435\u043C \u043D\u0435 \u043C\u0435\u043D\u0435\u0435, \u043D\u0435
    \u0445\u043E\u0442\u0438\u0442\u0435 \u043B\u0438 \u0432\u044B, \u0447\u0442\u043E\u0431\u044B
    \u044F \u043F\u043E\u0432\u0442\u043E\u0440\u0438\u043B \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u043D\u0430\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u044F?"
  LeftChoice:
    text: "\u0421\u043E\u0433\u043B\u0430\u0441\u0438\u0442\u044C\u0441\u044F"
    effects: []
    addFlags:
    - 1.1
    removeFlags: []
    reactionText: "\u0412\u0430\u0448\u0430 \u0432\u043B\u0430\u0441\u0442\u044C
      \u0441\u0442\u043E\u0438\u0442 \u043D\u0430 \u0448\u0435\u0441\u0442\u0438
      \u0441\u0442\u043E\u043B\u043F\u0430\u0445. \u041A\u0430\u0437\u043D\u0430,
      \u0430\u0440\u043C\u0438\u044F \u0438 \u0447\u0435\u0442\u044B\u0440\u0435
      \u043D\u0430\u0440\u043E\u0434\u0430, \u043D\u0430\u0441\u0435\u043B\u044F\u044E\u0449\u0438\u0445
      \u0441\u0442\u0440\u0430\u043D\u0443. \\n\u0414\u043B\u044F \u043D\u0430\u0441
      \u043E\u043D\u0438 \u043B\u0438\u0448\u044C \u0440\u0435\u0441\u0443\u0440\u0441,
      \u0440\u0430\u0431\u043E\u0447\u0430\u044F \u0441\u043A\u043E\u0442\u0438\u043D\u0430.
      \u041D\u043E \u043F\u043E\u043C\u043D\u0438\u0442\u0435: \u0435\u0441\u043B\u0438
      \u0437\u0430\u043A\u0440\u0443\u0442\u0438\u0442\u044C \u0433\u0430\u0439\u043A\u0438
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0442\u0443\u0433\u043E, \u0442\u043E
      \u043E\u043D\u0438 \u0437\u0430\u0445\u043E\u0442\u044F\u0442 \u043F\u043E\u0434\u043D\u044F\u0442\u044C
      \u0440\u0443\u043A\u0443 \u043D\u0430 \u0432\u0430\u0441. \\n\\n\u0415\u0441\u043B\u0438
      \u0434\u0430\u0442\u044C \u0441\u043B\u0430\u0431\u0438\u043D\u0443 \u2014
      \u043E\u043D\u0438 \u0442\u043E\u0436\u0435 \u0441\u043E\u0436\u0440\u0443\u0442
      \u0432\u0430\u0441 \u0436\u0438\u0432\u044C\u0435\u043C.\\n\\n\u041A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u0430\u044F
      \u043A\u043E\u0440\u043E\u043D\u0430 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u0430
      \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0432\u0430\u043C \u0441\u043C\u0443\u0442\u043D\u044B\u0435
      \u043E\u0447\u0435\u0440\u0442\u0430\u043D\u0438\u044F \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043E.
      \u041F\u043E \u043A\u0440\u0430\u0439\u043D\u0435\u0439 \u043C\u0435\u0440\u0435,
      \u0442\u0430\u043A \u043C\u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u043B
      \u0432\u0430\u0448 \u043E\u0442\u0435\u0446.\r\n\u0410 \u0442\u0435\u043F\u0435\u0440\u044C
      \u043F\u043E\u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0439\u0442\u0435
      \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043B\u044F
      \u043E\u0434\u043D\u043E\u0433\u043E \u0438\u0437 \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u044B\u0445
      \u043D\u0430\u0440\u043E\u0434\u043E\u0432 \u043D\u0430\u0448\u0435\u0433\u043E
      \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0430. \u041F\u0440\u0438\u044F\u0442\u043D\u043E\u0433\u043E
      \u043E\u0431\u0449\u0435\u043D\u0438\u044F..."
    rewardItem: {fileID: 0}
    rewardAmount: 1
  RightChoice:
    text: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F"
