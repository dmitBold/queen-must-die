  CardText: "\u0414\u043E\u043B\u0433\u0438\u0445 \u043B\u0435\u0442, \u0412\u0430\u0448\u0435
    \u0412\u0435\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E! \u0421\u043A\u043E\u0440\u0431\u043B\u044E
    \u043E \u0432\u0430\u0448\u0435\u043C \u043E\u0442\u0446\u0435, \u043D\u043E
    \u0434\u0435\u043B\u0430 \u043D\u0435 \u0436\u0434\u0443\u0442. \u0415\u0441\u0442\u044C
    \u0442\u0443\u0442 \u0443 \u043D\u0430\u0441 \u0437\u0435\u043C\u043B\u0438 \u043D\u0430
    \u0433\u0440\u0430\u043D\u0438\u0446\u0435 \u0437\u043C\u0435\u0438\u043D\u044B\u0445
    \u043D\u043E\u0440. \u0424\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E \u043D\u0435
    \u043E\u0442\u043D\u043E\u0441\u044F\u0442\u0441\u044F \u043D\u0438 \u043A \u043E\u0434\u043D\u043E\u0439
    \u0438\u0437 \u043F\u0440\u043E\u0432\u0438\u043D\u0446\u0438\u0439, \u043D\u043E
    \u043F\u0440\u043E\u0436\u0438\u0432\u0430\u044E\u0442 \u0442\u0430\u043C \u0438\u043C\u0435\u043D\u043D\u043E
    \u0437\u043C\u0435\u0438. \u041D\u0430\u043C \u0431\u0443\u0434\u0435\u0442 \u0432\u044B\u0433\u043E\u0434\u043D\u043E
    \u0437\u0430\u0441\u0435\u043B\u0438\u0442\u044C \u0438\u0445 \u043B\u044E\u0434\u044C\u043C\u0438,
    \u0430 \u0437\u043C\u0435\u0438 \u043C\u043E\u0433\u0443\u0442 \u0438 \u043F\u043E\u0442\u0435\u0441\u043D\u0438\u0442\u044C\u0441\u044F."
