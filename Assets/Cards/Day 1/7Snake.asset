  m_Name: 7Snake
  m_EditorClassIdentifier: Assembly-CSharp::CardData
  CardText: "\u0412\u044B \u0443\u0436\u0435 \u0434\u043E\u043B\u0436\u043D\u044B
    \u0437\u043D\u0430\u0442\u044C \u0437\u0430\u0447\u0435\u043C \u044F \u043E\u0431\u0440\u0430\u0449\u0430\u044E\u0441\u044C
    \u043A \u0432\u0430\u043C. \u0427\u0442\u043E \u0431\u044B \u0432\u044B \u043D\u0435
    \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B\u0438 \u0441\u0434\u0435\u043B\u0430\u0442\u044C
    \u0441 \u043C\u043E\u0438\u043C \u043D\u0430\u0440\u043E\u0434\u043E\u043C -
    \u044F \u044D\u0442\u043E \u0441\u0434\u0435\u043B\u0430\u044E. \u0422\u043E\u043B\u044C\u043A\u043E
    \u0434\u0430\u0439\u0442\u0435 \u043C\u043D\u0435 \u0441\u0431\u0435\u0436\u0430\u0442\u044C
    \u0441 \u043D\u0435\u0439. \u041C\u043D\u0435 \u043D\u0435 \u043D\u0443\u0436\u043D\u0430
    \u0432\u043B\u0430\u0441\u0442\u044C, \u043C\u043D\u0435 \u043D\u0443\u0436\u043D\u0430
    \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u043D\u0430."
  LeftChoice:
    text: "\u0421\u043E\u0433\u043B\u0430\u0441\u0438\u0442\u044C\u0441\u044F"
    effects:
    - type: 0
      stat: 1
      value: 15
    addFlags:
    - 1.7
    removeFlags: []
    reactionText: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E. \u041C\u043E\u044F
      \u0441\u0443\u0436\u0435\u043D\u0430\u044F \u0445\u043E\u0447\u0435\u0442,
      \u0447\u0442\u043E\u0431\u044B \u0432\u044B \u043F\u043E\u0436\u0435\u043D\u0438\u043B\u0438
      \u043D\u0430\u0441 \u0441\u0432\u043E\u0438\u043C \u0443\u043A\u0430\u0437\u043E\u043C,
      \u043D\u043E \u044D\u0442\u043E \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u043E\u043F\u0430\u0441\u043D\u043E. \\n\u041C\u044B \u0435\u0449\u0451 \u043F\u0440\u0438\u0434\u0435\u043C
      \u043A \u0432\u0430\u043C \u0437\u0430 \u043F\u043E\u043C\u043E\u0449\u044C\u044E,
      \u043A\u043E\u0433\u0434\u0430 \u043D\u0430\u0441\u0442\u0430\u043D\u0435\u0442
      \u0440\u0435\u0448\u0430\u044E\u0449\u0438\u0439 \u0447\u0430\u0441."
    rewardItem: {fileID: 0}
    rewardAmount: 1
  RightChoice:
    text: "\u041A\u043E\u0440\u043E\u043D\u0435 \u043D\u0435\u0447\u0435\u043C \u043F\u043E\u043C\u043E\u0447\u044C"
