  CardText: "\u0412\u0430\u0448 \u043E\u0442\u0435\u0446 \u043E\u0441\u0442\u0430\u0432\u0438\u043B
    \u043D\u0430\u043C \u043F\u0440\u0430\u0432\u043E \u0436\u0438\u0437\u043D\u0438,
    \u043D\u043E \u043C\u044B \u0437\u0430\u0434\u0430\u0435\u043C\u0441\u044F \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u043C
    - \u0437\u0430\u0447\u0435\u043C? \u0412\u044B \u0432\u0438\u0434\u0438\u0442\u0435
    \u043A\u0430\u043A \u043C\u044B \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u043C.
    \u041D\u0430\u043C \u043D\u0443\u0436\u043D\u044B \u0432\u0430\u0448\u0438 \u0442\u0435\u043B\u0430
    \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F,
    \u043D\u043E \u043D\u0438\u043A\u0442\u043E \u043D\u0430\u043C \u0438\u0445 \u043D\u0435
    \u0434\u0430\u0435\u0442 \u0441 \u043A\u043E\u043D\u0446\u0430 \u0432\u043E\u0439\u043D\u044B.\u0412\u0430\u043C
    \u043D\u0443\u0436\u043D\u044B \u043D\u0430\u0448\u0438 \u043F\u043E\u0441\u0435\u0432\u044B,
    \u043D\u043E \u0431\u0435\u0437 \u0441\u0432\u0435\u0436\u0438\u0445 \u0442\u0435\u043B
    \u043C\u044B \u0432\u0441\u0451 \u043C\u0435\u043D\u0435\u0435 \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u044B"
