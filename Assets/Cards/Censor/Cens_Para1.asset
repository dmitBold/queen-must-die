  CardText: "\u0418\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u043E \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E
    \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u044F\u0442\u044C! \u041D\u0430\u0448
    \u043F\u0440\u043E\u0441\u043B\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439
    \u043C\u043E\u0434\u0435\u043B\u044C\u0435\u0440 \u0437\u0430\u0434\u0443\u043C\u0430\u043B
    \u0433\u0440\u0430\u043D\u0434\u0438\u043E\u0437\u043D\u0443\u044E \u043A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u044E,
    \u0432\u0434\u043E\u0445\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u0443\u044E
    \u0432\u0430\u0448\u0438\u043C \u043E\u0431\u0440\u0430\u0437\u043E\u043C. \u0421\u043F\u043B\u0435\u0442\u0435\u043D\u0438\u0435
    \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u043E\u0439 \u043C\u043E\u0434\u044B
    \u0438 \u043D\u0430\u0448\u0435\u0439 \u0441\u043B\u043E\u0436\u043D\u0435\u0439\u0448\u0435\u0439
    \u0432\u044F\u0437\u0438. \u042D\u0442\u043E \u0441\u0442\u0430\u043D\u0435\u0442
    \u0441\u0438\u043C\u0432\u043E\u043B\u043E\u043C \u043D\u043E\u0432\u043E\u0439
    \u044D\u043F\u043E\u0445\u0438! \u0415\u043C\u0443 \u043D\u0443\u0436\u043D\u043E
    \u043B\u0438\u0448\u044C \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0437\u043E\u043B\u043E\u0442\u0430
