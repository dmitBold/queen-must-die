--- !u!114 &3210973568429628540
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6569665595932051922}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 17593cab2020f8c43a7063ec459d6989, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NoteInteractable
  noteImage: {fileID: 21300000, guid: a99d56a46c4079a4989e7058665975ee, type: 3}
  noteText:
  - "\u0421 \u0434\u043D\u0435\u043C \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F,
    \u0434\u043E\u0440\u043E\u0433\u0430\u044F \u0411\u0435\u0442! "
  - "\u0412 \u0441\u0442\u043E\u043B\u0438\u0446\u0435 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442
    \u0447\u0442\u043E-\u0442\u043E \u0432\u0430\u0436\u043D\u043E\u0435. \u0416\u0434\u0438
    \u043C\u0435\u043D\u044F \u0442\u043E\u043B\u044C\u043A\u043E \u043A \u0432\u0435\u0447\u0435\u0440\u0443.
    \u042F \u0432\u0435\u0437\u0443 \u0442\u0435\u0431\u0435 \u043D\u043E\u0432\u044B\u0439
    \u043F\u043E\u0434\u0430\u0440\u043E\u043A, \u043D\u043E <u>\u0435\u0441\u043B\u0438
    \u044F \u043E\u043F\u044F\u0441\u044C \u0443\u0432\u0438\u0436\u0443 \u0431\u0430\u0440\u0434\u0430\u043A</u>,
    \u0442\u043E \u0442\u044B \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u0448\u044C! "
  - "\u0418 \u043F\u043E\u043C\u043D\u0438. \u0414\u0430\u0436\u0435 \u0434\u0435\u043D\u044C
    \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F \u043D\u0435 \u043F\u043E\u0432\u043E\u0434
    \u0432\u044B\u0445\u043E\u0434\u0438\u0442\u044C \u043D\u0430 \u0443\u043B\u0438\u0446\u0443
    \u043F\u0440\u0438 \u0441\u0432\u0435\u0442\u0435 \u0441\u043E\u043B\u043D\u0446\u0430."
  trigger_once: 1
  noteEvent:
    m_PersistentCalls:
      m_Calls: []
